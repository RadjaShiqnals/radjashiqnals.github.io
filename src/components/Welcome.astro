---
import { Icon } from 'astro-icon/components';
const projects = [
  {
    title: 'Java Project',
    logo: '/projects/Java.png',
    images: ['/projects/Java1.png', '/projects/Java2.png', '/projects/Java3.png'],
    link: 'https://github.com/RadjaShiqnals/JavaProject',
    description: 'A collection of Java OOP and geometry projects, including inheritance and volume calculations for 3D shapes.',
  },
  {
    title: 'Toko Online (Online Shop)',
    logo: '/projects/TokoOnline.jpeg',
    images: ['/projects/TokoOnline2.jpeg', '/projects/TokoOnline3.jpeg', '/projects/TokoOnline4.jpeg'],
    link: 'https://github.com/RadjaShiqnals/TokoOnline',
    description: 'A full-featured online shop web application with product management, cart, and transaction features.',
  },
  {
    title: 'Medtrack',
    logo: '/projects/MedTrackLogo.png',
    images: ['/projects/MedTrack1.png', '/projects/MedTrack2.png', '/projects/MedTrack3.png'],
    link: 'https://www.figma.com/design/lsYYkr3WivyFrGkZNYAWK5/MedTrack--nai-archive?node-id=0-1&node-type=CANVAS&t=Q0nZ34F9n1mB65PE-0',
    description: 'A mobile app UI/UX prototype for tracking medication schedules, designed in Figma.',
  },
];
---

<div class="px-6 lg:px-12 pb-24 max-w-5xl mx-auto w-full">
    
    <!-- Hero Section -->
    <section id="home" class="flex flex-col justify-center min-h-[85vh] py-12">
        <div class="space-y-6 animate-fade-in-up">
            <span class="inline-block py-1 px-3 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-wide border border-blue-200 dark:border-blue-800">
                Hi there, Welcome back!
            </span>
            
            <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-tight">
                I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-sky-400 dark:from-blue-400 dark:to-sky-300">Radja Genta</span><br/> Saputra
            </h1>
            
            <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-400 max-w-2xl font-light leading-relaxed">
                Full-Stack Web Developer <span class="text-blue-500">•</span> UI/UX Enthusiast <span class="text-blue-500">•</span> Junior Software Engineer
            </p>

            <div class="flex gap-4 pt-6">
                <a href="https://github.com/RadjaShiqnals" target="_blank" aria-label="GitHub" class="p-3 bg-white dark:bg-slate-800 rounded-xl hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/20 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all border border-slate-200 dark:border-slate-700">
                    <Icon name="mdi:github" class="w-7 h-7" />
                </a>
                <a href="https://www.linkedin.com/in/radja-genta-saputra/" target="_blank" aria-label="LinkedIn" class="p-3 bg-white dark:bg-slate-800 rounded-xl hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/20 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all border border-slate-200 dark:border-slate-700">
                    <Icon name="mdi:linkedin" class="w-7 h-7" />
                </a>
                <a href="https://x.com/RadjaShiqnals" target="_blank" aria-label="Twitter" class="p-3 bg-white dark:bg-slate-800 rounded-xl hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/20 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all border border-slate-200 dark:border-slate-700">
                    <Icon name="mdi:twitter" class="w-7 h-7" />
                </a>
                <a href="https://www.instagram.com/radjashiqnals/" target="_blank" aria-label="Instagram" class="p-3 bg-white dark:bg-slate-800 rounded-xl hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/20 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-all border border-slate-200 dark:border-slate-700">
                    <Icon name="mdi:instagram" class="w-7 h-7" />
                </a>
            </div>
        </div>
    </section>

    <!-- About Me Section -->
    <section id="about" class="py-20 scroll-mt-20 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-3">
            <span class="w-8 h-1 bg-blue-500 rounded-full inline-block"></span>
            About Me
        </h2>
        
        <div class="bg-white/60 dark:bg-slate-900/40 backdrop-blur-md rounded-3xl p-8 md:p-12 border border-white/50 dark:border-slate-700/50 shadow-xl shadow-slate-200/50 dark:shadow-none transition-all">
            <p class="text-lg md:text-xl leading-relaxed text-slate-700 dark:text-slate-300">
                A passionate and driven full-stack web developer with a strong foundation in <span class="text-red-500 font-medium">Laravel</span> and <span class="text-green-500 font-medium">Vue.js</span>. I bring a mix of curiosity, creativity, and professionalism to every line of code I write. Whether building responsive UIs in <span class="text-cyan-500 font-medium">React</span>, designing APIs in Laravel, or styling components with <span class="text-sky-500 font-medium">TailwindCSS</span>, I strive to make every experience seamless, scalable, and impactful.
            </p>
            
            <div class="mt-8 flex flex-wrap gap-3">
                <span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium border border-slate-200 dark:border-slate-700">#Laravel</span>
                <span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium border border-slate-200 dark:border-slate-700">#Vue.js</span>
                <span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium border border-slate-200 dark:border-slate-700">#React</span>
                <span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium border border-slate-200 dark:border-slate-700">#TailwindCSS</span>
                <span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm font-medium border border-slate-200 dark:border-slate-700">#Figma</span>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-20 scroll-mt-20 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
                <span class="w-8 h-1 bg-blue-500 rounded-full inline-block"></span>
                My Projects
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {projects.map((project) => (
                <div class="group bg-white dark:bg-slate-800 rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-2xl hover:shadow-blue-500/10 dark:hover:shadow-blue-900/20 transition-all duration-300 flex flex-col h-full">
                    
                    <div class="aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-900 relative">
                        {project.images[0] ? (
                            <img src={project.images[0]} alt={`${project.title} Preview`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
                        ) : (
                            <div class="flex items-center justify-center h-full text-slate-400">No Image</div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    
                    <div class="p-6 flex flex-col flex-grow">
                        <div class="flex items-center gap-4 mb-4">
                            {project.logo && (
                                <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700 overflow-hidden flex-shrink-0 border border-slate-200 dark:border-slate-600">
                                    <img src={project.logo} alt="Logo" class="w-full h-full object-cover" />
                                </div>
                            )}
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-tight">
                                {project.title}
                            </h3>
                        </div>
                        
                        <p class="text-slate-600 dark:text-slate-400 text-sm mb-6 flex-grow leading-relaxed">
                            {project.description}
                        </p>
                        
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center justify-center gap-2 w-full py-3 px-4 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 rounded-xl font-medium border border-slate-200 dark:border-slate-700 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 dark:hover:border-blue-500 transition-colors">
                            View Project
                            <Icon name="mdi:arrow-top-right" class="w-4 h-4" />
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>
    
    <footer class="mt-20 pt-8 border-t border-slate-200 dark:border-slate-800 text-center text-slate-500 dark:text-slate-400 text-sm pb-8">
        © {new Date().getFullYear()} Radja Genta Saputra. System Design.
    </footer>
