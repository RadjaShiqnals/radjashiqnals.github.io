---
import { Icon } from 'astro-icon/components';
import portfolioData from '../data/portfolio.json';

interface Props {
  profileStats?: {
    username: string;
    avatar_url: string;
    name: string;
    bio: string;
    location: string;
    public_repos: number;
    followers: number;
    following: number;
    total_stars: number;
    total_forks: number;
    languages: Array<{ name: string; count: number }>;
  };
}

const { profileStats } = Astro.props;
const { profile, skills, projects, support } = portfolioData;

const avatarUrl = profileStats?.avatar_url || "https://avatars.githubusercontent.com/u/123444114?v=4";
const repoCount = profileStats?.public_repos ?? 33;
const followerCount = profileStats?.followers ?? 23;
const languagesList = profileStats?.languages || [
  { name: 'JavaScript', count: 11 },
  { name: 'PHP', count: 9 },
  { name: 'TypeScript', count: 2 },
  { name: 'Astro', count: 1 },
  { name: 'HTML/CSS', count: 3 }
];
---

<div class="page-wrapper animate-fade-in-up">
    
    <!-- Hero Section -->
    <section id="home" class="hero-section py-8 md:py-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-6 flex flex-col items-center lg:items-start justify-center">
                <!-- Status Badge -->
                <div class="flex items-center gap-3 mb-6 flex-wrap justify-center lg:justify-start">
                    <div class="status-badge">
                        <span class="status-dot"></span>
                        Available for tech lead & fullstack work
                    </div>
                </div>
                
                <!-- Avatar & Name Header -->
                <div class="flex items-center gap-4 mb-4">
                    <img 
                        src={avatarUrl} 
                        alt={profile.name} 
                        class="w-16 h-16 md:w-20 md:h-20 rounded-full border-2 border-zinc-800 object-cover shadow-lg shrink-0" 
                    />
                    <div class="text-center lg:text-left">
                        <h1 class="heading-display !mb-1 text-2xl md:text-4xl">
                            {profile.name}
                        </h1>
                        <p class="text-xs md:text-sm text-zinc-400 font-mono">
                            @{profileStats?.username || "RadjaShiqnals"}
                        </p>
                    </div>
                </div>
                
                <p class="text-lead text-zinc-300 text-sm md:text-base mb-6 text-center lg:text-left">
                    {profile.role}
                </p>

                <!-- Quick Stats Pill Row -->
                <div class="flex flex-wrap gap-2 text-[11px] font-mono mb-6 select-none justify-center lg:justify-start">
                    <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 flex items-center gap-1.5">
                        <Icon name="mdi:folder-multiple-outline" class="w-3.5 h-3.5 text-zinc-400" />
                        repos: <strong class="text-white">{repoCount}</strong>
                    </span>
                    <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 flex items-center gap-1.5">
                        <Icon name="mdi:account-group-outline" class="w-3.5 h-3.5 text-zinc-400" />
                        followers: <strong class="text-white">{followerCount}</strong>
                    </span>
                    <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400 flex items-center gap-1.5">
                        <Icon name="mdi:map-marker-outline" class="w-3.5 h-3.5 text-zinc-400" />
                        Malang / Probolinggo
                    </span>
                </div>

                <!-- Social Links -->
                <div class="social-list justify-center lg:justify-start">
                    <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
                        <Icon name="mdi:github" class="w-4 h-4" /> github
                    </a>
                    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
                        <Icon name="mdi:linkedin" class="w-4 h-4" /> linkedin
                    </a>
                    <a href={profile.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="social-link">
                        <Icon name="mdi:twitter" class="w-4 h-4" /> twitter
                    </a>
                    <a href={profile.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
                        <Icon name="mdi:instagram" class="w-4 h-4" /> instagram
                    </a>
                </div>
            </div>

            <!-- Right Interactive Developer Card Column -->
            <div class="lg:col-span-6 w-full">
                <div class="terminal-box">
                    
                    <!-- Tab Header -->
                    <div class="tab-header">
                        <button id="tab-profile" class="tab-btn active" data-target="content-profile">
                            <Icon name="mdi:account-outline" class="w-3 h-3 shrink-0" />
                            <span>[ ~ ] profile</span>
                        </button>
                        <button id="tab-stats" class="tab-btn" data-target="content-stats">
                            <Icon name="mdi:chart-bar" class="w-3 h-3 shrink-0" />
                            <span>[ $ ] stats</span>
                        </button>
                        <button id="tab-terminal" class="tab-btn" data-target="content-terminal">
                            <Icon name="mdi:console" class="w-3 h-3 shrink-0" />
                            <span>[ &gt; ] terminal</span>
                        </button>
                    </div>

                    <!-- Tab Content Container -->
                    <div class="p-5 md:p-6 min-h-[260px] flex flex-col justify-between">
                        
                        <!-- Content 1: Profile Overview -->
                        <div id="content-profile" class="tab-panel space-y-4">
                            <div class="text-xs text-zinc-400 leading-relaxed space-y-2">
                                <p><span class="text-emerald-400 font-bold">$ whoami</span></p>
                                <p class="pl-3 text-zinc-300">
                                    Fullstack Developer & Tech Lead managing multi-page enterprise software (SIDIGS) and open-source projects.
                                </p>
                            </div>
                            
                            <div class="border-t border-zinc-900 pt-3 text-xs space-y-2">
                                <div class="flex justify-between items-center text-zinc-400">
                                    <span>OS / Desktop:</span>
                                    <span class="text-zinc-200 font-mono">CachyOS / Hyprland (end4)</span>
                                </div>
                                <div class="flex justify-between items-center text-zinc-400">
                                    <span>Editor & Tools:</span>
                                    <span class="text-zinc-200 font-mono">VSCode / Neovim (NvChad)</span>
                                </div>
                                <div class="flex justify-between items-center text-zinc-400">
                                    <span>Core Tech Stack:</span>
                                    <span class="text-zinc-200 font-mono">Laravel, Vue.js, Astro, Tailwind</span>
                                </div>
                            </div>

                            <div class="pt-2 flex flex-wrap gap-1.5">
                                <span class="px-2 py-0.5 bg-zinc-900 text-zinc-300 text-[10px] font-mono border border-zinc-800">#Laravel</span>
                                <span class="px-2 py-0.5 bg-zinc-900 text-zinc-300 text-[10px] font-mono border border-zinc-800">#VueJS</span>
                                <span class="px-2 py-0.5 bg-zinc-900 text-zinc-300 text-[10px] font-mono border border-zinc-800">#Astro</span>
                                <span class="px-2 py-0.5 bg-zinc-900 text-zinc-300 text-[10px] font-mono border border-zinc-800">#Tailwind</span>
                                <span class="px-2 py-0.5 bg-zinc-900 text-zinc-300 text-[10px] font-mono border border-zinc-800">#LinuxPowerUser</span>
                            </div>
                        </div>

                        <!-- Content 2: GitHub Stats -->
                        <div id="content-stats" class="tab-panel hidden space-y-4">
                            <div class="text-xs text-zinc-400 flex items-center justify-between border-b border-zinc-900 pb-2">
                                <span class="text-emerald-400 font-bold">$ gh user stats</span>
                                <span class="text-[10px] text-zinc-500">Live Cached Build Data</span>
                            </div>

                            <div class="grid grid-cols-2 gap-3 text-xs">
                                <div class="bg-zinc-900/40 p-3 border border-zinc-900">
                                    <div class="text-zinc-500 text-[10px] uppercase">Public Repos</div>
                                    <div class="text-lg font-bold text-white mt-1">{repoCount}</div>
                                </div>
                                <div class="bg-zinc-900/40 p-3 border border-zinc-900">
                                    <div class="text-zinc-500 text-[10px] uppercase">Followers</div>
                                    <div class="text-lg font-bold text-white mt-1">{followerCount}</div>
                                </div>
                            </div>

                            <div class="space-y-2 pt-1">
                                <div class="text-[11px] text-zinc-400 font-semibold">Top Languages in Repositories:</div>
                                <div class="space-y-1.5">
                                    {languagesList.slice(0, 4).map((lang) => (
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-zinc-300 flex items-center gap-1.5">
                                                <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                                                {lang.name}
                                            </span>
                                            <span class="text-zinc-500 text-[11px]">{lang.count} repos</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>

                        <!-- Content 3: Mini Interactive Terminal -->
                        <div id="content-terminal" class="tab-panel hidden flex flex-col h-full justify-between">
                            <div id="terminal-output" class="text-xs text-zinc-300 space-y-2 max-h-[160px] overflow-y-auto mb-3 font-mono">
                                <p class="text-zinc-500">[ Interactive Terminal initialized. Type a command or click quick chips below. ]</p>
                                <p><span class="text-emerald-400">radja@cachyos</span>:<span class="text-sky-400">~</span>$ help</p>
                                <p class="text-zinc-400">Available commands: <span class="text-white">whoami</span>, <span class="text-white">skills</span>, <span class="text-white">projects</span>, <span class="text-white">tools</span>, <span class="text-white">contact</span>, <span class="text-white">clear</span></p>
                            </div>

                            <!-- Command Chips -->
                            <div class="flex flex-wrap gap-1.5 mb-3 border-t border-zinc-900 pt-2">
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="whoami">whoami</button>
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="skills">skills</button>
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="projects">projects</button>
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-emerald-400 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="tools">tools</button>
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="contact">contact</button>
                                <button class="cmd-chip px-2 py-0.5 bg-zinc-900 hover:bg-zinc-800 text-red-400 text-[10px] font-mono border border-zinc-800 transition-colors cursor-pointer" data-cmd="clear">clear</button>
                            </div>

                            <!-- Input line -->
                            <form id="terminal-form" class="terminal-input-line">
                                <span class="text-emerald-400 font-bold">$</span>
                                <input 
                                    type="text" 
                                    id="terminal-input" 
                                    class="terminal-input" 
                                    placeholder="type a command..." 
                                    autocomplete="off" 
                                    aria-label="Terminal command input"
                                />
                            </form>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- About Me Section -->
    <section id="about" class="section-container">
        <h2 class="heading-1">
            <span>01.</span> About Me
        </h2>
        
        <div class="glass-card mb-8">
            <p class="text-body">
                A passionate and driven full-stack web developer with a strong foundation in
                <span
                    class="tech-term"
                    data-name="Laravel"
                    data-desc="A PHP web application framework with expressive, elegant syntax. Provides routing, auth, queuing, and ORM (Eloquent) out of the box."
                    data-url="https://laravel.com/docs"
                    data-tag="PHP Framework"
                >Laravel</span> and
                <span
                    class="tech-term"
                    data-name="Vue.js"
                    data-desc="A progressive JavaScript framework for building user interfaces. Designed to be incrementally adoptable — works as a library or full-featured framework."
                    data-url="https://vuejs.org/guide/introduction"
                    data-tag="JS Framework"
                >Vue.js</span>. I bring a mix of curiosity, creativity, and system-level tuning to every codebase I touch. Whether engineering responsive client interfaces, scaling back-ends, or managing platform deployments, I focus on clean performance and simplicity.
            </p>
        </div>
        
        <div class="glass-card">
            <h3 class="text-xs font-bold text-white mb-6 uppercase tracking-widest font-mono select-none">
                [core-skills]
            </h3>
            <div class="space-y-4">
                {skills.map((skill) => (
                    <div class="flex items-start gap-4 text-xs md:text-sm font-mono">
                        <span class="text-emerald-400 font-bold select-none">[x]</span>
                        <div>
                            <span
                                class="tech-term block md:inline md:mr-2"
                                data-name={skill.name}
                                data-desc={skill.desc}
                                data-url={skill.url || ''}
                                data-tag="Core Skill"
                            >{skill.name}</span>
                            <span class="text-zinc-500">- {skill.desc}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section-container">
        <h2 class="heading-1">
            <span>02.</span> Featured Projects
        </h2>

        <div class="project-grid">
            {projects.map((project) => (
                <div class="project-card group">
                    <div class="project-image-wrap">
                        {project.images && project.images[0] ? (
                            <img src={project.images[0]} alt={`${project.title} Preview`} class="project-image" />
                        ) : (
                            <div class="project-placeholder">[ no preview image ]</div>
                        )}
                    </div>
                    
                    <div class="project-body">
                        <div class="flex items-center gap-3 mb-4">
                            {project.logo && (
                                <img src={project.logo} alt="" class="w-6 h-6 rounded border border-zinc-900 bg-zinc-950 object-cover flex-shrink-0" />
                            )}
                            <h3 class="heading-3">
                                {project.title}
                            </h3>
                        </div>
                        
                        <p class="text-muted mb-6 flex-grow">
                            {project.description}
                        </p>
                        
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-action-link">
                            [ view project ]
                        </a>
                    </div>
                </div>
            ))}
        </div>

        <div class="flex justify-center mt-10">
            <a href="/projects" class="btn-primary">
                [ view all repositories ]
            </a>
        </div>
    </section>

    <!-- Support Section -->
    <section id="support" class="section-container mb-8">
        <h2 class="heading-1">
            <span>03.</span> Support & Sponsorship
        </h2>
        
        <div class="support-grid">
            <!-- Left: Saweria -->
            <div class="support-card">
                <div class="support-icon-wrap">
                    <Icon name="mdi:wallet-giftcard" class="w-5 h-5 text-zinc-400" />
                </div>
                <h3 class="support-title">Local Support</h3>
                <p class="support-desc">
                    E-wallets and QRIS options optimized for local support (Saweria).
                </p>
                <a href={support.saweria} target="_blank" rel="noopener noreferrer" class="support-btn">
                    [ support via saweria ]
                </a>
            </div>
            
            <!-- Right: Ko-Fi -->
            <div class="support-card">
                <div class="support-icon-wrap">
                    <Icon name="mdi:wallet-giftcard" class="w-5 h-5 text-zinc-400" />
                </div>
                <h3 class="support-title">Global Support</h3>
                <p class="support-desc">
                    Credit cards, PayPal, and international sponsorship options (Ko-fi).
                </p>
                <a href={support.kofi} target="_blank" rel="noopener noreferrer" class="support-btn">
                    [ support via ko-fi ]
                </a>
            </div>
        </div>
    </section>

</div>

<!-- Shared Tech Tooltip Popup -->
<div id="tech-popup" role="tooltip">
    <div class="px-4 py-1.5 border-b border-zinc-800 bg-zinc-900/60 flex items-center justify-between gap-3">
        <span id="tech-popup-name" class="font-bold text-white text-xs"></span>
        <span id="tech-popup-tag" class="text-[9px] px-1.5 py-0.5 bg-zinc-800 text-zinc-400 uppercase tracking-widest"></span>
    </div>
    <div class="px-4 py-3">
        <p id="tech-popup-desc" class="text-zinc-300 leading-relaxed mb-3 text-[11px]"></p>
        <a id="tech-popup-link" href="#" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1.5 text-[11px] text-emerald-400 hover:text-emerald-300 transition-colors underline underline-offset-2 decoration-emerald-700">
            &#8599; official docs
        </a>
    </div>
</div>

<!-- Client-side Interactive Tab & Terminal Script -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // Tab switching logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabPanels = document.querySelectorAll('.tab-panel');

        tabBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                tabBtns.forEach((b) => b.classList.remove('active'));
                tabPanels.forEach((p) => p.classList.add('hidden'));

                btn.classList.add('active');
                const targetPanel = document.getElementById(targetId);
                if (targetPanel) {
                    targetPanel.classList.remove('hidden');
                }
            });
        });

        // Mini Terminal logic
        const termForm = document.getElementById('terminal-form');
        const termInput = document.getElementById('terminal-input');
        const termOutput = document.getElementById('terminal-output');
        const cmdChips = document.querySelectorAll('.cmd-chip');

        function runCommand(cmd) {
            const cleanCmd = cmd.trim().toLowerCase();
            if (!cleanCmd) return;

            if (cleanCmd === 'clear') {
                termOutput.innerHTML = '<p class="text-zinc-500">[ Terminal output cleared. ]</p>';
                return;
            }

            const pCmd = document.createElement('p');
            pCmd.innerHTML = `<span class="text-emerald-400">radja@cachyos</span>:<span class="text-sky-400">~</span>$ ${cleanCmd}`;
            termOutput.appendChild(pCmd);

            const pRes = document.createElement('p');
            pRes.className = 'text-zinc-400 pl-3 mb-2';

            switch (cleanCmd) {
                case 'whoami':
                    pRes.textContent = 'Radja Genta Saputra - Full-Stack Developer & Tech Lead at SIDIGS. Daily Linux (CachyOS/Hyprland) user.';
                    break;
                case 'skills':
                    pRes.textContent = 'Core Skills: PHP, Laravel, Vue.js, Astro, Tailwind CSS, MySQL, Linux Systems, Neovim.';
                    break;
                case 'projects':
                    pRes.textContent = 'Featured Projects: SIDIGS Platform, MommyScript, Java Geometric Toolkit, Medtrack Figma UI.';
                    break;
                case 'tools':
                    pRes.innerHTML = 'Free Utilities: <a href="/tools/downloader" class="underline text-emerald-400">Media Downloader</a> | <a href="/tools/converter" class="underline text-sky-400">Media Converter & Compressor</a>';
                    break;
                case 'contact':
                    pRes.innerHTML = 'Links: <a href="https://github.com/RadjaShiqnals" target="_blank" class="underline text-white">GitHub</a> | <a href="https://www.linkedin.com/in/radja-genta-saputra/" target="_blank" class="underline text-white">LinkedIn</a>';
                    break;
                default:
                    pRes.textContent = `Command not found: ${cleanCmd}. Try 'whoami', 'skills', 'projects', 'contact', or 'clear'.`;
            }

            termOutput.appendChild(pRes);
            termOutput.scrollTop = termOutput.scrollHeight;
        }

        if (termForm && termInput) {
            termForm.addEventListener('submit', (e) => {
                e.preventDefault();
                runCommand(termInput.value);
                termInput.value = '';
            });
        }

        cmdChips.forEach((chip) => {
            chip.addEventListener('click', () => {
                const cmd = chip.getAttribute('data-cmd');
                if (cmd) {
                    runCommand(cmd);
                }
            });
        });

        // Tech Term Tooltip logic
        const popup = document.getElementById('tech-popup');
        const popupName = document.getElementById('tech-popup-name');
        const popupTag = document.getElementById('tech-popup-tag');
        const popupDesc = document.getElementById('tech-popup-desc');
        const popupLink = document.getElementById('tech-popup-link');

        let hideTimer = null;

        function showPopup(el, e) {
            if (!popup || !el) return;
            clearTimeout(hideTimer);

            popupName.textContent = el.dataset.name || '';
            popupTag.textContent = el.dataset.tag || '';
            popupDesc.textContent = el.dataset.desc || '';
            const url = el.dataset.url || '';
            if (url) {
                popupLink.href = url;
                popupLink.style.display = 'inline-flex';
            } else {
                popupLink.style.display = 'none';
            }

            // Position near cursor, keep within viewport
            const vw = window.innerWidth;
            const vh = window.innerHeight;
            const pw = 300;
            const ph = 120;
            let x = e.clientX + 16;
            let y = e.clientY + 12;
            if (x + pw > vw - 12) x = e.clientX - pw - 8;
            if (y + ph > vh - 12) y = e.clientY - ph - 8;

            popup.style.left = x + 'px';
            popup.style.top = y + 'px';
            popup.classList.add('visible');
        }

        function scheduleHide() {
            hideTimer = setTimeout(() => {
                if (popup) popup.classList.remove('visible');
            }, 150);
        }

        document.querySelectorAll('.tech-term').forEach((term) => {
            term.addEventListener('mouseenter', (e) => showPopup(term, e));
            term.addEventListener('mousemove', (e) => showPopup(term, e));
            term.addEventListener('mouseleave', scheduleHide);
        });

        if (popup) {
            popup.addEventListener('mouseenter', () => clearTimeout(hideTimer));
            popup.addEventListener('mouseleave', scheduleHide);
        }
    });
</script>
