---
import { Icon } from 'astro-icon/components';
import portfolioData from '../data/portfolio.json';

const { profile, skills, projects, support } = portfolioData;
---

<div class="page-wrapper animate-fade-in-up">
    
    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div>
            <div class="hero-badge">
                <span class="text-yellow-600">[ INFO ]</span>&nbsp;Welcome
            </div>
            
            <h1 class="heading-display">
                {profile.name}
            </h1>
            
            <p class="text-lead">
                {profile.role}
            </p>

            <div class="social-list">
                <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
                    <Icon name="mdi:github" class="w-4 h-4" /> github
                </a>
                <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
                    <Icon name="mdi:linkedin" class="w-4 h-4" /> linkedin
                </a>
                <a href={profile.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="social-link">
                    <Icon name="mdi:twitter" class="w-4 h-4" /> twitter
                </a>
                <a href={profile.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
                    <Icon name="mdi:instagram" class="w-4 h-4" /> instagram
                </a>
            </div>
        </div>
    </section>

    <!-- About Me Section -->
    <section id="about" class="section-container">
        <h2 class="heading-1">
            <span>01.</span> About Me
        </h2>
        
        <div class="glass-card mb-8">
            <p class="text-body">
                A passionate and driven full-stack web developer with a strong foundation in <span class="text-white font-bold underline decoration-zinc-800 underline-offset-4">Laravel</span> and <span class="text-white font-bold underline decoration-zinc-800 underline-offset-4">Vue.js</span>. I bring a mix of curiosity, creativity, and system-level tuning to every codebase I touch. Whether engineering responsive client interfaces, scaling back-ends, or managing platform deployments, I focus on clean performance and simplicity.
            </p>
        </div>
        
        <div class="skills-box">
            <h3 class="skills-title">
                [core-skills]
            </h3>
            <div class="space-y-4">
                {skills.map((skill) => (
                    <div class="skill-item">
                        <span class="skill-checkbox">[x]</span>
                        <div class="skill-details">
                            <span class="skill-name">{skill.name}</span>
                            <span class="skill-desc">- {skill.desc}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section-container">
        <h2 class="heading-1">
            <span>02.</span> Projects
        </h2>

        <div class="project-grid">
            {projects.map((project) => (
                <div class="project-card group">
                    <div class="project-image-wrap">
                        {project.images[0] ? (
                            <img src={project.images[0]} alt={`${project.title} Preview`} class="project-image" />
                        ) : (
                            <div class="project-placeholder">[ no preview image ]</div>
                        )}
                    </div>
                    
                    <div class="project-body">
                        <div class="project-header">
                            {project.logo && (
                                <img src={project.logo} alt="" class="project-logo" />
                            )}
                            <h3 class="heading-3">
                                {project.title}
                            </h3>
                        </div>
                        
                        <p class="text-muted mb-6 flex-grow">
                            {project.description}
                        </p>
                        
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-action-link">
                            [ view project ]
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Support Section -->
    <section id="support" class="section-container mb-8">
        <h2 class="heading-1">
            <span>03.</span> Support & Sponsorship
        </h2>
        
        <div class="support-grid">
            <!-- Left: Saweria -->
            <div class="support-card">
                <div class="support-icon-wrap">
                    <Icon name="mdi:wallet-giftcard" class="w-5 h-5 text-zinc-500" />
                </div>
                <h4 class="support-title">Local Support</h4>
                <p class="support-desc">
                    E-wallets and QRIS options optimized for local support (Saweria).
                </p>
                <a href={support.saweria} target="_blank" rel="noopener noreferrer" class="support-btn">
                    [ support via saweria ]
                </a>
            </div>
            
            <!-- Right: Ko-Fi -->
            <div class="support-card">
                <div class="support-icon-wrap">
                    <Icon name="mdi:wallet-giftcard" class="w-5 h-5 text-zinc-500" />
                </div>
                <h4 class="support-title">Global Support</h4>
                <p class="support-desc">
                    Credit cards, PayPal, and international sponsorship options (Ko-fi).
                </p>
                <a href={support.kofi} target="_blank" rel="noopener noreferrer" class="support-btn">
                    [ support via ko-fi ]
                </a>
            </div>
        </div>
    </section>

</div>
