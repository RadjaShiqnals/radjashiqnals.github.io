---
import { Icon } from 'astro-icon/components';
import cuteVideo from '/output.mp4';
const projects = [
  {
    title: 'Java Project',
    logo: '/projects/Java.png',
    images: ['/projects/Java1.png', '/projects/Java2.png', '/projects/Java3.png'],
    link: 'https://github.com/RadjaShiqnals/JavaProject',
    description: 'A collection of Java OOP and geometry projects, including inheritance and volume calculations for 3D shapes.',
  },
  {
    title: 'Toko Online (Online Shop)',
    logo: '/projects/TokoOnline.jpeg',
    images: ['/projects/TokoOnline2.jpeg', '/projects/TokoOnline3.jpeg', '/projects/TokoOnline4.jpeg'],
    link: 'https://github.com/RadjaShiqnals/TokoOnline',
    description: 'A full-featured online shop web application with product management, cart, and transaction features.',
  },
  {
    title: 'Medtrack',
    logo: '/projects/MedTrackLogo.png',
    images: ['/projects/MedTrack1.png', '/projects/MedTrack2.png', '/projects/MedTrack3.png'],
    link: 'https://www.figma.com/design/lsYYkr3WivyFrGkZNYAWK5/MedTrack--nai-archive?node-id=0-1&node-type=CANVAS&t=Q0nZ34F9n1mB65PE-0',
    description: 'A mobile app UI/UX prototype for tracking medication schedules, designed in Figma.',
  },
];
---

<div class="relative font-sans text-white">
    <div class="fixed top-0 left-0 -z-10 h-full w-full">
        <video
            id="bg-video"
            loop
            playsinline
            class="h-full w-full object-cover"
        >
            <source src={cuteVideo} type="video/mp4" />
            Your browser does not support the video tag.
        </video>
        <!-- The separate audio tag is no longer needed -->
        <div class="absolute top-0 left-0 h-full w-full bg-black bg-opacity-60"></div>
    </div>

    <div
        class="fixed top-5 left-1/2 z-20 flex -translate-x-1/2 items-center gap-4 rounded-full bg-black/50 p-2 px-4 backdrop-blur-sm"
    >
        <!-- Volume Slider -->
        <label for="volume-slider" class="sr-only">Volume</label>
        <input
            type="range"
            id="volume-slider"
            min="0"
            max="1"
            step="0.01"
            value="0.5"
            class="w-20"
            aria-label="Volume"
        />

        <!-- Play/Pause Button -->
        <button id="play-pause-btn" aria-label="Pause/Play Video" class="flex-shrink-0">
            <Icon name="mdi:pause" class="h-6 w-6" id="pause-icon" />
            <Icon name="mdi:play" class="hidden h-6 w-6" id="play-icon" />
        </button>

        <!-- Speed Slider -->
        <label for="speed-slider" class="sr-only">Speed</label>
        <input
            type="range"
            id="speed-slider"
            min="0.5"
            max="2"
            step="0.25"
            value="1"
            class="w-20"
            aria-label="Playback Speed"
        />
    </div>

    <main class="relative z-10">
        <!-- Hero Section -->
        <section
            id="hero"
            class="flex min-h-screen flex-col items-center justify-center p-4 text-center"
        >
            <div class="mb-6 h-32 w-32 rounded-full bg-kita-red"></div>
            <h1 class="mb-2 text-5xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]">
                Radja Genta Saputra
            </h1>
            <p class="mb-6 text-xl text-gray-400 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]">
                Full-Stack Web Developer | UI/UX Enthusiast | Junior Software Engineer
            </p>
            <div class="flex justify-center space-x-6">
                <a
                    href="https://github.com/RadjaShiqnals"
                    target="_blank"
                    aria-label="GitHub"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:github" class="h-8 w-8" />
                </a>
                <a
                    href="https://www.linkedin.com/in/radja-genta-saputra/"
                    target="_blank"
                    aria-label="LinkedIn"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:linkedin" class="h-8 w-8" />
                </a>
                <a
                    href="https://x.com/RadjaShiqnals"
                    target="_blank"
                    aria-label="Twitter"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:twitter" class="h-8 w-8" />
                </a>
                <a
                    href="https://www.instagram.com/radjashiqnals/"
                    target="_blank"
                    aria-label="Instagram"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:instagram" class="h-8 w-8" />
                </a>
            </div>
        </section>

        <!-- About Me Section -->
        <section id="about" class="py-20">
            <div class="container mx-auto max-w-3xl px-4">
                <h2
                    class="mb-8 text-center text-3xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]"
                >
                    About Me
                </h2>
                <p
                    class="text-center text-lg leading-relaxed text-gray-300 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]"
                >
                    A passionate and driven full-stack web developer with a strong foundation in Laravel and
                    Vue.js. I bring a mix of curiosity, creativity, and professionalism to every line of
                    code I write. Whether building responsive UIs in React, designing APIs in Laravel, or
                    styling components with TailwindCSS, I strive to make every experience seamless,
                    scalable, and impactful.
                </p>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="py-20">
          <div class="container mx-auto px-4">
            <h2 class="mb-12 text-center text-3xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]">
              My Projects
            </h2>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {projects.map((project, idx) => (
                <div
                  class="cursor-pointer transform overflow-hidden rounded-lg bg-kita-shirt transition-transform duration-300 hover:-translate-y-2"
                  onclick={`window.showProjectModal(${idx})`}
                >
                  <div class="p-6 flex flex-col items-center">
                    <img src={project.logo} alt={project.title + ' logo'} class="mb-4 h-20 w-20 object-contain rounded-lg" />
                    <h3 class="mb-2 text-xl font-bold">{project.title}</h3>
                    <p class="mb-4 text-gray-400 text-center">{project.description}</p>
                    <a href={project.link} target="_blank" class="mt-2 text-kita-red underline">View Project</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <dialog id="project-modal" class="p-0 bg-transparent">
          <div id="modal-content" class="bg-kita-shirt rounded-lg max-w-lg w-full p-6 relative text-white hidden"></div>
        </dialog>

        <dialog id="image-modal" class="p-0 bg-transparent">
          <div id="image-modal-content" class="relative flex items-center justify-center">
            <!-- Image will be injected here -->
          </div>
        </dialog>
    </main>

    <footer class="relative z-10 py-8 text-center">
        <p class="text-gray-500">
            &copy; {new Date().getFullYear()} Radja Genta Saputra. All rights reserved.
        </p>
    </footer>
</div>

<style>
    dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.8);
    }
    dialog {
        border: none;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    input[type='range'] {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        cursor: pointer;
    }
    /* Track */
    input[type='range']::-webkit-slider-runnable-track {
        background: #555;
        height: 0.25rem;
        border-radius: 1rem;
    }
    input[type='range']::-moz-range-track {
        background: #555;
        height: 0.25rem;
        border-radius: 1rem;
    }
    /* Thumb */
    input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        margin-top: -6px;
        background-color: #fff;
        height: 1rem;
        width: 1rem;
        border-radius: 50%;
        transition: background-color 150ms;
    }
    input[type='range']::-moz-range-thumb {
        border: none;
        background-color: #fff;
        height: 1rem;
        width: 1rem;
        border-radius: 50%;
        transition: background-color 150ms;
    }
    input[type='range']:hover::-webkit-slider-thumb {
        background-color: #ccc;
    }
    input[type='range']:hover::-moz-range-thumb {
        background-color: #ccc;
    }
</style>

<script>
    declare global {
        interface Window {
            showProjectModal: (idx: number) => void;
            closeProjectModal: () => void;
            showImageModal: (imgSrc: string) => void;
            closeImageModal: () => void;
        }
    }
    document.addEventListener('DOMContentLoaded', () => {
        const video = document.getElementById('bg-video') as HTMLVideoElement;
        const playPauseBtn = document.getElementById('play-pause-btn');
        const playIcon = document.getElementById('play-icon');
        const pauseIcon = document.getElementById('pause-icon');
        const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
        const speedSlider = document.getElementById('speed-slider') as HTMLInputElement;

        if (video && playPauseBtn && playIcon && pauseIcon && volumeSlider && speedSlider) {
            video.playbackRate = parseFloat(speedSlider.value);

            const updateButton = () => {
                if (video.paused) {
                    playIcon.classList.remove('hidden');
                    pauseIcon.classList.add('hidden');
                } else {
                    playIcon.classList.add('hidden');
                    pauseIcon.classList.remove('hidden');
                }
            };

            video.muted = true;
            video.volume = parseFloat(volumeSlider.value); 
            video.play().catch(() => {
                updateButton();
            });

            playPauseBtn.addEventListener('click', () => {
                if (video.paused) {
                    video.play();
                } else {
                    video.pause();
                }
                if (video.muted) {
                    video.muted = false;
                }
            });

            video.addEventListener('play', updateButton);
            video.addEventListener('pause', updateButton);

            // Listeners for sliders
            volumeSlider.addEventListener('input', (e) => {
                const target = e.target as HTMLInputElement;
                const newVolume = parseFloat(target.value);
                video.volume = newVolume;

                video.muted = newVolume === 0;
            });

            speedSlider.addEventListener('input', (e) => {
                const target = e.target as HTMLInputElement;
                video.playbackRate = parseFloat(target.value);

                if (video.muted) {
                    video.muted = false;
                }
            });
        }

        const imageModal = document.getElementById('image-modal') as HTMLDialogElement;
        if (imageModal) {
            imageModal.addEventListener('click', (event) => {
                if (event.target === imageModal) {
                    window.closeImageModal();
                }
            });
        }
    });

    const projectsData = [
        {
            title: 'Java Project',
            logo: '/projects/Java.png',
            images: ['/projects/Java1.png', '/projects/Java2.png', '/projects/Java3.png'],
            link: 'https://github.com/RadjaShiqnals/JavaProject',
            description: 'A collection of Java OOP and geometry projects, including inheritance and volume calculations for 3D shapes.',
        },
        {
            title: 'Toko Online (Online Shop)',
            logo: '/projects/TokoOnline.jpeg',
            images: ['/projects/TokoOnline2.jpeg', '/projects/TokoOnline3.jpeg', '/projects/TokoOnline4.jpeg'],
            link: 'https://github.com/RadjaShiqnals/TokoOnline',
            description: 'A full-featured online shop web application with product management, cart, and transaction features.',
        },
        {
            title: 'Medtrack',
            logo: '/projects/MedTrackLogo.png',
            images: ['/projects/MedTrack1.png', '/projects/MedTrack2.png', '/projects/MedTrack3.png'],
            link: 'https://www.figma.com/design/lsYYkr3WivyFrGkZNYAWK5/MedTrack--nai-archive?node-id=0-1&node-type=CANVAS&t=Q0nZ34F9n1mB65PE-0',
            description: 'A mobile app UI/UX prototype for tracking medication schedules, designed in Figma.',
        },
    ];

    window.showProjectModal = function(idx: number) {
        const modal = document.getElementById('project-modal') as HTMLDialogElement;
        const content = document.getElementById('modal-content');
        const project = projectsData[idx];
        if (modal && content && project) {
            content.innerHTML = `
                <button class="absolute top-2 right-2 text-gray-400 hover:text-white text-2xl z-10" onclick="window.closeProjectModal()" aria-label="Close">&times;</button>
                <img src="${project.logo}" alt="${project.title} logo" class="mb-4 h-24 w-24 object-contain mx-auto rounded-lg" />
                <h3 class="mb-2 text-2xl font-bold text-center">${project.title}</h3>
                <p class="mb-4 text-gray-300 text-center">${project.description}</p>
                <div class="flex flex-wrap justify-center gap-4 mb-4">
                  ${project.images.map(img => `<img src="${img}" alt="Project detail" class="h-32 w-32 object-cover rounded-md border border-gray-700 cursor-zoom-in" onclick="window.showImageModal('${img}')"/>`).join('')}
                </div>
                <a href="${project.link}" target="_blank" class="block text-center text-kita-red underline font-bold">Open Project</a>
            `;
            content.classList.remove('hidden');
            modal.showModal();
        }
    };

    window.closeProjectModal = function() {
        const modal = document.getElementById('project-modal') as HTMLDialogElement;
        const content = document.getElementById('modal-content');
        if (modal && content) {
            modal.close();
            content.classList.add('hidden');
            content.innerHTML = '';
        }
    };

    window.showImageModal = function(imgSrc: string) {
        const modal = document.getElementById('image-modal') as HTMLDialogElement;
        const content = document.getElementById('image-modal-content');
        if (modal && content) {
            content.innerHTML = `
                <img src="${imgSrc}" alt="Zoomed Image" class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-lg" />
            `;
            modal.showModal();
        }
    };

    window.closeImageModal = function() {
        const modal = document.getElementById('image-modal') as HTMLDialogElement;
        const content = document.getElementById('image-modal-content');
        if (modal && content) {
            modal.close();
            content.innerHTML = '';
        }
    };
</script>
