---
import { Icon } from 'astro-icon/components';
import cuteVideo from '/cute.mp4';
---

<div class="relative font-sans text-white">
    <div class="fixed top-0 left-0 -z-10 h-full w-full">
        <video
            id="bg-video"
            autoplay
            loop
            muted
            playsinline
            class="h-full w-full object-cover"
        >
            <source src={cuteVideo} type="video/mp4" />
            Your browser does not support the video tag.
        </video>
        <div class="absolute top-0 left-0 h-full w-full bg-black bg-opacity-60"></div>
    </div>

    <button
        id="play-pause-btn"
        aria-label="Pause/Play Video"
        class="fixed top-5 left-1/2 z-20 -translate-x-1/2 rounded-full bg-black/50 p-2 transition-colors hover:bg-black/75"
    >
        <Icon name="mdi:pause" class="h-6 w-6" id="pause-icon" />
        <Icon name="mdi:play" class="hidden h-6 w-6" id="play-icon" />
    </button>

    <main class="relative z-10">
        <!-- Hero Section -->
        <section
            id="hero"
            class="flex min-h-screen flex-col items-center justify-center p-4 text-center"
        >
            <div class="mb-6 h-32 w-32 rounded-full bg-kita-red"></div>
            <h1 class="mb-2 text-5xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]">
                Radja Genta Saputra
            </h1>
            <p class="mb-6 text-xl text-gray-400 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]">
                Full-Stack Web Developer | UI/UX Enthusiast | Junior Software Engineer
            </p>
            <div class="flex justify-center space-x-6">
                <a
                    href="https://github.com/RadjaShiqnals"
                    target="_blank"
                    aria-label="GitHub"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:github" class="h-8 w-8" />
                </a>
                <a
                    href="https://www.linkedin.com/in/radja-genta-saputra/"
                    target="_blank"
                    aria-label="LinkedIn"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:linkedin" class="h-8 w-8" />
                </a>
                <a
                    href="https://x.com/RadjaShiqnals"
                    target="_blank"
                    aria-label="Twitter"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:twitter" class="h-8 w-8" />
                </a>
                <a
                    href="https://www.instagram.com/radjashiqnals/"
                    target="_blank"
                    aria-label="Instagram"
                    class="text-gray-400 transition-colors hover:text-white"
                >
                    <Icon name="mdi:instagram" class="h-8 w-8" />
                </a>
            </div>
        </section>

        <!-- About Me Section -->
        <section id="about" class="py-20">
            <div class="container mx-auto max-w-3xl px-4">
                <h2
                    class="mb-8 text-center text-3xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]"
                >
                    About Me
                </h2>
                <p
                    class="text-center text-lg leading-relaxed text-gray-300 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]"
                >
                    A passionate and driven full-stack web developer with a strong foundation in Laravel and
                    Vue.js. I bring a mix of curiosity, creativity, and professionalism to every line of
                    code I write. Whether building responsive UIs in React, designing APIs in Laravel, or
                    styling components with TailwindCSS, I strive to make every experience seamless,
                    scalable, and impactful.
                </p>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="py-20">
            <div class="container mx-auto px-4">
                <h2
                    class="mb-12 text-center text-3xl font-bold [text-shadow:0_2px_4px_rgba(0,0,0,0.8)]"
                >
                    My Projects
                </h2>
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    <!-- Project Card 1 -->
                    <div
                        class="transform overflow-hidden rounded-lg bg-kita-shirt transition-transform duration-300 hover:-translate-y-2"
                    >
                        <div class="p-6">
                            <h3 class="mb-2 text-xl font-bold">Vehicle Reservation System</h3>
                            <p class="mb-4 text-gray-400">
                                Handles hierarchical approval, driver assignment, and tracking. Features JWT-based
                                auth and exportable reports.
                            </p>
                            <div class="flex flex-wrap gap-2">
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >Laravel 11</span
                                >
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >React</span
                                >
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >JWT</span
                                >
                            </div>
                        </div>
                    </div>
                    <!-- Project Card 2 -->
                    <div
                        class="transform overflow-hidden rounded-lg bg-kita-shirt transition-transform duration-300 hover:-translate-y-2"
                    >
                        <div class="p-6">
                            <h3 class="mb-2 text-xl font-bold">MedTrack UI/UX Prototype</h3>
                            <p class="mb-4 text-gray-400">
                                Designed and prototyped a mobile app UI to track medication schedules, created in
                                collaboration with health professionals.
                            </p>
                            <div class="flex flex-wrap gap-2">
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >Figma</span
                                >
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >UI/UX Design</span
                                >
                            </div>
                        </div>
                    </div>
                    <!-- Project Card 3 -->
                    <div
                        class="transform overflow-hidden rounded-lg bg-kita-shirt transition-transform duration-300 hover:-translate-y-2"
                    >
                        <div class="p-6">
                            <h3 class="mb-2 text-xl font-bold">Wikusama Café App</h3>
                            <p class="mb-4 text-gray-400">
                                Internal school project for a digital café ordering system with a modular admin
                                interface and responsive design.
                            </p>
                            <div class="flex flex-wrap gap-2">
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >Vue.js</span
                                >
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >Laravel</span
                                >
                                <span class="rounded-full bg-kita-red px-2.5 py-1 text-xs font-semibold"
                                    >Tailwind</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="relative z-10 py-8 text-center">
        <p class="text-gray-500">
            &copy; {new Date().getFullYear()} Radja Genta Saputra. All rights reserved.
        </p>
    </footer>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const video = document.getElementById('bg-video') as HTMLVideoElement;
        const playPauseBtn = document.getElementById('play-pause-btn');
        const playIcon = document.getElementById('play-icon');
        const pauseIcon = document.getElementById('pause-icon');

        if (video && playPauseBtn && playIcon && pauseIcon) {
            const updateButton = () => {
                if (video.paused) {
                    playIcon.classList.remove('hidden');
                    pauseIcon.classList.add('hidden');
                } else {
                    playIcon.classList.add('hidden');
                    pauseIcon.classList.remove('hidden');
                }
            };

            const isPaused = localStorage.getItem('videoPaused') === 'true';
            if (isPaused) {
                video.pause();
            } else {
                video.play().catch(() => {
                    // Autoplay was prevented, update state and UI
                    localStorage.setItem('videoPaused', 'true');
                    updateButton();
                });
            }
            updateButton();

            playPauseBtn.addEventListener('click', () => {
                if (video.paused) {
                    video.play();
                    localStorage.setItem('videoPaused', 'false');
                } else {
                    video.pause();
                    localStorage.setItem('videoPaused', 'true');
                }
            });

            video.addEventListener('play', updateButton);
            video.addEventListener('pause', updateButton);
        }
    });
</script>
