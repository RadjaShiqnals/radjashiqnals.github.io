---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const CACHE_PATH = path.resolve('src/data/github-cache.json');
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;

let repos = [];
let fetchSuccess = false;

try {
  const headers = {
    'Accept': 'application/vnd.github.v3+json',
    'User-Agent': 'Astro-Portfolio-Builder'
  };
  if (GITHUB_TOKEN) {
    headers['Authorization'] = `token ${GITHUB_TOKEN.trim()}`;
  }

  // Fetch repositories from public API
  const response = await fetch('https://api.github.com/users/RadjaShiqnals/repos?per_page=100', { headers });
  if (response.ok) {
    const data = await response.json();
    repos = data
      .filter((repo) => !repo.fork)
      .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
    
    // Save to local cache
    fs.writeFileSync(CACHE_PATH, JSON.stringify(repos, null, 2), 'utf-8');
    fetchSuccess = true;
  } else {
    console.error(`[GitHub Sync] API Error: ${response.status} ${response.statusText}`);
  }
} catch (error) {
  console.error('[GitHub Sync] Network error fetching repositories:', error);
}

// Fallback to cache if fetch failed
if (!fetchSuccess) {
  try {
    if (fs.existsSync(CACHE_PATH)) {
      const cachedData = fs.readFileSync(CACHE_PATH, 'utf-8');
      repos = JSON.parse(cachedData);
    }
  } catch (cacheError) {
    console.error('[GitHub Sync] Failed to read from cache:', cacheError);
  }
}

// Map language to CSS class
const getLangClass = (lang) => {
  if (!lang) return '';
  const cleanLang = lang.toLowerCase();
  if (cleanLang === 'php') return 'lang-php';
  if (cleanLang === 'javascript' || cleanLang === 'js') return 'lang-js';
  if (cleanLang === 'vue') return 'lang-vue';
  if (cleanLang === 'astro') return 'lang-astro';
  if (cleanLang === 'css') return 'lang-css';
  if (cleanLang === 'typescript' || cleanLang === 'ts') return 'lang-typescript';
  if (cleanLang === 'java') return 'lang-java';
  if (cleanLang === 'html') return 'lang-html';
  return 'lang-other';
};
---

<Layout title="Projects & Repositories - Radja Genta">
    <div class="page-wrapper animate-fade-in-up">
        
        <!-- Header area -->
        <section class="py-8 flex flex-col justify-center">
            <div class="hero-badge">
                [ repos ] github listings
            </div>
            
            <h1 class="heading-display mb-2">
                Public Repositories
            </h1>
            
            <p class="text-lead mb-6">
                All public repositories sourced directly from my GitHub profile.
            </p>
        </section>

        <!-- Search Input -->
        <div class="w-full">
            <input 
                type="text" 
                id="repo-search" 
                class="search-input" 
                placeholder="Type to search repositories..." 
                autocomplete="off"
                aria-label="Search repositories"
            />
        </div>

        <!-- Repos Grid -->
        <div class="project-grid mb-12" id="repo-grid">
            {repos.map((repo) => (
                <div class="project-card repo-item" data-repo-name={repo.name.toLowerCase()} data-repo-desc={(repo.description || '').toLowerCase()}>
                    <div class="p-6 flex flex-col flex-grow">
                        <div class="flex items-center justify-between mb-3 gap-2">
                            <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="heading-3 hover:underline truncate">
                                {repo.name}
                            </a>
                            <span class="text-[9px] text-zinc-500 border border-zinc-900 bg-zinc-950 px-1.5 py-0.5 select-none shrink-0 uppercase tracking-widest font-mono">
                                public
                            </span>
                        </div>
                        
                        <p class="text-muted mb-6 flex-grow line-clamp-3">
                            {repo.description || "No description provided."}
                        </p>
                        
                        <div class="flex items-center gap-4 text-[10px] text-zinc-500 mt-auto select-none pt-4 border-t border-zinc-900/50 flex-wrap">
                            {repo.language && (
                                <span class="flex items-center gap-1.5">
                                    <span class={`lang-dot ${getLangClass(repo.language)}`}></span>
                                    {repo.language}
                                </span>
                            )}
                            {repo.stargazers_count > 0 && (
                                <span class="flex items-center gap-1">
                                    ★ {repo.stargazers_count}
                                </span>
                            )}
                            {repo.forks_count > 0 && (
                                <span class="flex items-center gap-1">
                                    Y {repo.forks_count}
                                </span>
                            )}
                            <span class="ml-auto text-[9px] text-zinc-600">
                                {new Date(repo.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                            </span>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- No Results Fallback -->
        <div id="no-results" class="text-center py-16 text-zinc-500 font-mono text-xs hidden dark-border">
            [ no repositories match your search query ]
        </div>

        <!-- Back Button -->
        <div class="flex justify-center mb-16">
            <a href="/" class="btn-primary">
                [ return to home ]
            </a>
        </div>

    </div>

    <!-- Client-side filter script -->
    <script is:inline>
        const searchInput = document.getElementById('repo-search');
        const repoItems = document.querySelectorAll('.repo-item');
        const noResults = document.getElementById('no-results');
        const repoGrid = document.getElementById('repo-grid');

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();
                let matchCount = 0;

                repoItems.forEach((item) => {
                    const name = item.getAttribute('data-repo-name') || '';
                    const desc = item.getAttribute('data-repo-desc') || '';
                    
                    if (name.includes(query) || desc.includes(query)) {
                        item.style.display = 'flex';
                        matchCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (matchCount === 0) {
                    noResults.classList.remove('hidden');
                    repoGrid.style.display = 'none';
                } else {
                    noResults.classList.add('hidden');
                    repoGrid.style.display = 'grid';
                }
            });
        }
    </script>
</Layout>
