---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Happy Eid Al-Fitr 2026">
  <div class="px-6 lg:px-12 pb-24 max-w-3xl mx-auto w-full flex flex-col items-center justify-center min-h-[75vh]">
    
    <!-- Step 1: Initial Greeting -->
    <div id="step-1" class="text-center space-y-8 w-full animate-fade-in-up">
      <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 dark:text-white leading-tight">
        Happy Eid Al-Fitr 2026! ✨
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-300">
        May this special day bring peace, happiness, and prosperity to everyone.
        <br/><span class="text-blue-500 font-semibold block mt-4">— RadjaShiqnals</span>
      </p>
      
      <div class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md rounded-3xl p-8 border border-white/50 dark:border-slate-700/50 shadow-xl shadow-slate-200/50 dark:shadow-none mt-8 transition-all">
        <p class="text-lg md:text-xl text-slate-700 dark:text-slate-200 mb-8 font-medium">
          Wanted to give some THR (Eid money)? 😇
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button id="btn-yes" class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-all hover:-translate-y-1 shadow-lg shadow-blue-500/30 w-full sm:w-auto mt-2">
            Yes, for sure!
          </button>
          <button id="btn-no" class="px-8 py-4 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 border border-slate-200 dark:border-slate-700 rounded-xl font-bold transition-all w-full sm:w-auto mt-2">
            Nu-uh, maybe next year
          </button>
        </div>
      </div>
    </div>

    <!-- Step 2 (No): Rejected Path -->
    <div id="step-no" class="hidden text-center space-y-6 w-full animate-fade-in-up">
      <div class="text-7xl mb-6">🥲</div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white">That's okay!</h2>
      <p class="text-xl text-slate-600 dark:text-slate-300 max-w-lg mx-auto">
        Thank you and absolutely best of luck to you! Wishing you a blessed Eid Al-Fitr.
      </p>
      <button onclick="location.reload()" class="mt-8 text-blue-500 hover:text-blue-600 dark:hover:text-blue-400 font-medium underline inline-block">Start over</button>
    </div>

    <!-- Step 3 (Yes): Detail View with QRIS -->
    <div id="step-yes" class="hidden text-center w-full animate-fade-in-up mt-8">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6">Yay, Thank you! 🎉</h2>
      
      <div class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md rounded-3xl p-6 md:p-8 border border-white/50 dark:border-slate-700/50 shadow-xl shadow-slate-200/50 dark:shadow-none inline-block max-w-sm w-full mx-auto relative overflow-hidden group">
        
        <!-- Glow effect -->
        <div class="absolute -inset-2 bg-gradient-to-r from-blue-500 to-cyan-400 blur-xl opacity-20 group-hover:opacity-40 transition duration-500 z-0"></div>

        <div class="relative z-10 flex flex-col items-center">
            
            <!-- QRIS Output Format -->
            <img src="/qris.png" alt="QRIS Code" class="w-full max-w-[250px] aspect-square object-contain p-2 bg-white rounded-2xl border-4 border-slate-200 shadow-md mb-4" onerror="this.src='data:image/svg+xml;base64,'" />
            
            <div class="w-full text-left bg-slate-50 dark:bg-slate-800/80 rounded-xl p-4 mb-6 border border-slate-200 dark:border-slate-700">
                <div class="text-sm border-b border-dashed border-slate-200 dark:border-slate-700 pb-2 mb-2">
                    <p class="text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Merchant Name</p>
                    <p class="font-bold text-slate-800 dark:text-slate-100">RadjaShiqnals</p>
                </div>
                <div class="text-sm border-b border-dashed border-slate-200 dark:border-slate-700 pb-2 mb-2 hidden">
                    <p class="text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Merchant ID</p>
                    <p class="font-mono text-xs text-slate-800 dark:text-slate-200">ID1023277752888</p>
                </div>
                <div class="text-sm">
                    <p class="text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider font-semibold mb-1">Bank/Provider</p>
                    <p class="font-medium inline-block bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 py-1 px-2 rounded font-semibold text-xs border border-blue-200 dark:border-blue-800">
                        Bank Mandiri
                    </p>
                </div>
            </div>
            
            <button id="btn-done" class="w-full px-6 py-4 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold transition-all shadow-lg shadow-emerald-500/30 transform hover:-translate-y-1 mt-2">
                I have given money
            </button>
        </div>
      </div>
    </div>

    <!-- Step 4 (Success): Confirmed Payment -->
    <div id="step-success" class="hidden text-center space-y-6 w-full animate-fade-in-up mt-8">
      <div class="text-7xl mb-6">🙏</div>
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white">Thank you so much!</h2>
      <p class="text-xl text-slate-600 dark:text-slate-300 max-w-lg mx-auto">
        I really appreciate your kindness. Thank you, and wishing you the best of luck and immense prosperity!
      </p>
      <a href="/" class="inline-block mt-8 text-blue-500 hover:text-blue-600 dark:hover:text-blue-400 font-medium underline px-4 py-2 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors">
        Return to Home Page
      </a>
    </div>
    
  </div>
</Layout>

<script>
  // Simple client-side page routing behavior
  const step1 = document.getElementById('step-1');
  const stepNo = document.getElementById('step-no');
  const stepYes = document.getElementById('step-yes');
  const stepSuccess = document.getElementById('step-success');

  const btnYes = document.getElementById('btn-yes');
  const btnNo = document.getElementById('btn-no');
  const btnDone = document.getElementById('btn-done');

  if (btnYes && btnNo && btnDone) {
    btnYes.addEventListener('click', () => {
      step1.classList.add('hidden');
      stepYes.classList.remove('hidden');
    });

    btnNo.addEventListener('click', () => {
      step1.classList.add('hidden');
      stepNo.classList.remove('hidden');
    });

    btnDone.addEventListener('click', () => {
      stepYes.classList.add('hidden');
      stepSuccess.classList.remove('hidden');
    });
  }
</script>

<style>
.animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
}
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>