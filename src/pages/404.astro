---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="404: Not Found">
    <div class="error-container animate-fade-in-up">
        
        <div class="error-badge">
            [ error ] Page Not Found
        </div>

        <h1 class="error-title">
            404
        </h1>
        
        <div class="terminal-window">
            <div class="terminal-header">
                <span>shell - error_handler</span>
                <span class="w-4"></span>
            </div>
            <div class="terminal-body font-mono text-xs md:text-sm text-zinc-400 leading-relaxed">
                <span class="text-red-500 font-bold">Error:</span> The requested URL was not found on this server.
                <br />
                <span class="text-zinc-500">Status:</span> 404 (Not Found)
                <br />
                <span class="text-zinc-500">Action:</span> Please check the address or return to home.
            </div>
        </div>
        
        <div>
            <a href="/" class="btn-primary">
                <Icon name="mdi:home" class="w-4 h-4 flex-shrink-0" /> [ Go to Homepage ]
            </a>
        </div>
    </div>
</Layout>