---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="404: Not Found">
    <div class="flex flex-col items-center justify-center min-h-full py-20 px-6 lg:px-12 w-full max-w-5xl mx-auto animate-fade-in-up text-center">
        
        <br>
        
        <h1 class="text-9xl md:text-[150px] font-extrabold text-gradient tracking-tight leading-none">
            404
        </h1>
        
        <p class="mt-8 heading-1">
            Page Not Found
        </p>
        
        <p class="mt-4 text-body max-w-md mx-auto">
            Sorry, we couldn't find the page you were looking for.
        </p>
        
        <div class="mt-10">
            <a
                href="/"
                class="btn-primary"
            >
                <Icon name="mdi:home" class="w-5 h-5 flex-shrink-0" />
                Go to Homepage
            </a>
        </div>
    </div>
</Layout>