---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Universal Media Editor - 100% Client-Side - Radja Genta">
    <div class="page-wrapper animate-fade-in-up">

        <!-- Header -->
        <section class="py-6 md:py-8 flex flex-col items-center text-center">
            <div class="hero-badge">
                [ tool ] 100% client-side · no upload · no server
            </div>
            <h1 class="heading-display mb-2 text-2xl md:text-4xl">
                Universal Media Editor
            </h1>
            <p class="text-lead mb-6 text-xs md:text-sm max-w-lg">
                Edit images, audio, and video files directly in your browser. All processing happens locally — your files never leave your device.
            </p>
        </section>

        <!-- Main Tool Box -->
        <div class="glass-card mb-8 w-full max-w-4xl mx-auto p-0 overflow-hidden">

            <!-- Tab Header -->
            <div class="tab-header" id="tab-header">
                <button class="tab-btn active" data-tab="image">
                    <Icon name="mdi:image-edit-outline" class="w-3.5 h-3.5" /> Image
                </button>
                <button class="tab-btn" data-tab="audio">
                    <Icon name="mdi:waveform" class="w-3.5 h-3.5" /> Audio
                </button>
                <button class="tab-btn" data-tab="video">
                    <Icon name="mdi:video-outline" class="w-3.5 h-3.5" /> Video
                </button>
            </div>

            <!-- ========== IMAGE TAB ========== -->
            <div id="tab-image" class="tab-content p-5 md:p-6 space-y-5">
                <!-- Dropzone -->
                <div id="img-dropzone" class="border-2 border-dashed border-zinc-800 bg-zinc-950 p-8 text-center cursor-pointer hover:border-zinc-600 transition-colors select-none">
                    <input type="file" id="img-input" class="hidden" accept="image/*" />
                    <div class="w-10 h-10 border border-zinc-800 bg-zinc-900/60 flex items-center justify-center mx-auto mb-3">
                        <Icon name="mdi:image-plus-outline" class="w-5 h-5 text-emerald-400" />
                    </div>
                    <p class="text-xs font-mono text-zinc-200 font-bold mb-1">Click or drag & drop image</p>
                    <p class="text-[11px] font-mono text-zinc-500">JPG, PNG, WebP, GIF, AVIF, BMP, SVG</p>
                </div>

                <!-- Editor Panel (hidden until file loaded) -->
                <div id="img-editor" class="hidden space-y-4">
                    <!-- File Info Header with Animated Badge -->
                    <div class="flex items-center justify-between border border-zinc-800 bg-zinc-950 px-4 py-2 text-xs font-mono">
                        <div class="flex items-center gap-2 truncate max-w-xs">
                            <Icon name="mdi:image-outline" class="w-4 h-4 text-emerald-400 shrink-0" />
                            <span id="img-filename" class="font-bold text-white truncate">image.png</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="img-animated-badge" class="hidden text-[10px] px-2 py-0.5 bg-purple-950 text-purple-400 border border-purple-800 uppercase font-mono">
                                ● Animated GIF (0 frames)
                            </span>
                            <span id="img-dim-info" class="text-zinc-500 text-[11px]">0×0</span>
                        </div>
                    </div>

                    <!-- Canvas Preview + Live Text Overlay -->
                    <div class="border border-zinc-800 bg-zinc-950 flex items-center justify-center p-2 min-h-[180px] overflow-hidden relative" id="img-canvas-wrap">
                        <canvas id="img-canvas" class="max-w-full max-h-[400px] object-contain block"></canvas>
                        <!-- Live text overlay (preview only, not baked until Add Text clicked) -->
                        <div id="img-text-overlay" class="absolute pointer-events-none hidden" style="font-family:'JetBrains Mono',monospace; font-weight:bold; opacity:0.85; text-shadow:1px 1px 3px rgba(0,0,0,0.8); white-space:nowrap; bottom:20px; left:20px;"></div>
                    </div>

                    <!-- Controls Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
                        <!-- Transform -->
                        <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                            <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Transform</p>
                            <div class="flex flex-wrap gap-2">
                                <button class="img-action-btn" data-action="rotate-cw">↻ 90° CW</button>
                                <button class="img-action-btn" data-action="rotate-ccw">↺ 90° CCW</button>
                                <button class="img-action-btn" data-action="flip-h">⇆ Flip H</button>
                                <button class="img-action-btn" data-action="flip-v">⇅ Flip V</button>
                            </div>
                            <!-- Resize -->
                            <div class="space-y-2">
                                <p class="text-zinc-500 text-[10px]">Resize (px)</p>
                                <div class="flex gap-2 items-center">
                                    <input type="number" id="img-resize-w" class="w-20 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-zinc-100 outline-none focus:border-zinc-500" placeholder="W" />
                                    <span class="text-zinc-600">×</span>
                                    <input type="number" id="img-resize-h" class="w-20 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-zinc-100 outline-none focus:border-zinc-500" placeholder="H" />
                                    <label class="flex items-center gap-1.5 text-zinc-500 text-[10px] cursor-pointer">
                                        <input type="checkbox" id="img-lock-ratio" checked class="accent-emerald-500" /> Lock ratio
                                    </label>
                                </div>
                                <button class="img-action-btn w-full" data-action="resize">[ Apply Resize ]</button>
                            </div>
                        </div>

                        <!-- Filters -->
                        <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                            <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Filters</p>
                            <div class="space-y-2.5">
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Brightness</span>
                                    <input type="range" id="f-brightness" min="0" max="200" value="100" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-brightness-val" class="w-8 text-right text-emerald-400 text-[10px]">100</span>
                                </div>
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Contrast</span>
                                    <input type="range" id="f-contrast" min="0" max="200" value="100" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-contrast-val" class="w-8 text-right text-emerald-400 text-[10px]">100</span>
                                </div>
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Saturation</span>
                                    <input type="range" id="f-saturate" min="0" max="200" value="100" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-saturate-val" class="w-8 text-right text-emerald-400 text-[10px]">100</span>
                                </div>
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Blur (px)</span>
                                    <input type="range" id="f-blur" min="0" max="20" value="0" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-blur-val" class="w-8 text-right text-emerald-400 text-[10px]">0</span>
                                </div>
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Grayscale</span>
                                    <input type="range" id="f-grayscale" min="0" max="100" value="0" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-grayscale-val" class="w-8 text-right text-emerald-400 text-[10px]">0</span>
                                </div>
                                <div class="filter-row">
                                    <span class="w-24 text-zinc-500 text-[10px]">Sepia</span>
                                    <input type="range" id="f-sepia" min="0" max="100" value="0" class="flex-1 accent-emerald-500 cursor-pointer" />
                                    <span id="f-sepia-val" class="w-8 text-right text-emerald-400 text-[10px]">0</span>
                                </div>
                            </div>
                            <button class="img-action-btn w-full" data-action="reset-filters">[ Reset All Filters ]</button>
                        </div>
                    </div>

                    <!-- Text Overlay -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 font-mono text-xs space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Text Overlay</p>
                            <span class="text-[10px] text-emerald-500 font-mono">● live preview</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <input type="text" id="img-text" class="col-span-2 bg-zinc-900 border border-zinc-700 px-3 py-2 text-xs font-mono text-zinc-100 outline-none focus:border-zinc-500" placeholder="Type watermark or text..." />
                            <input type="color" id="img-text-color" value="#ffffff" class="bg-zinc-900 border border-zinc-700 h-9 w-full cursor-pointer" title="Text color" />
                        </div>
                        <div class="flex flex-wrap gap-3 items-center">
                            <label class="text-zinc-500 text-[10px]">Size:</label>
                            <input type="range" id="img-text-size" min="10" max="120" value="36" class="w-28 accent-emerald-500 cursor-pointer" />
                            <span id="img-text-size-val" class="text-emerald-400 text-[10px]">36px</span>
                            <div class="ml-auto flex gap-2">
                                <button class="img-action-btn text-zinc-500 border-zinc-800" data-action="clear-text">[ Clear ]</button>
                                <button class="img-action-btn" data-action="add-text">[ Bake to Image ]</button>
                            </div>
                        </div>
                        <p class="text-zinc-700 text-[10px]">Preview shows overlay above image. Click "Bake to Image" to permanently stamp it onto the canvas.</p>
                    </div>

                    <!-- Export -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 font-mono text-xs space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Export</p>
                        <div class="flex flex-wrap gap-3 items-center">
                            <select id="img-export-format" class="bg-zinc-900 border border-zinc-700 px-3 py-2 text-xs font-mono text-zinc-100 outline-none focus:border-zinc-500">
                                <option value="image/webp">WebP (Recommended)</option>
                                <option value="image/jpeg">JPEG</option>
                                <option value="image/png">PNG (Lossless)</option>
                            </select>
                            <div class="flex items-center gap-2">
                                <span class="text-zinc-500 text-[10px]">Quality:</span>
                                <input type="range" id="img-quality" min="10" max="100" value="90" class="w-24 accent-emerald-500 cursor-pointer" />
                                <span id="img-quality-val" class="text-emerald-400 text-[10px]">90%</span>
                            </div>
                            <button class="btn-primary ml-auto" id="img-download">⬇ Download Image</button>
                        </div>
                        <div id="img-status" class="hidden text-[11px] text-emerald-400 font-mono py-1"></div>
                        <button class="img-action-btn" data-action="reset-all">[ Reset & Load New File ]</button>
                    </div>
                </div>
            </div>

            <!-- ========== AUDIO TAB ========== -->
            <div id="tab-audio" class="tab-content hidden p-5 md:p-6 space-y-5">
                <!-- Dropzone -->
                <div id="aud-dropzone" class="border-2 border-dashed border-zinc-800 bg-zinc-950 p-8 text-center cursor-pointer hover:border-zinc-600 transition-colors select-none">
                    <input type="file" id="aud-input" class="hidden" accept="audio/*" />
                    <div class="w-10 h-10 border border-zinc-800 bg-zinc-900/60 flex items-center justify-center mx-auto mb-3">
                        <Icon name="mdi:music-note-plus" class="w-5 h-5 text-purple-400" />
                    </div>
                    <p class="text-xs font-mono text-zinc-200 font-bold mb-1">Click or drag & drop audio</p>
                    <p class="text-[11px] font-mono text-zinc-500">MP3, WAV, OGG, M4A, FLAC, AAC, OPUS</p>
                </div>

                <!-- Editor Panel -->
                <div id="aud-editor" class="hidden space-y-4 font-mono text-xs">
                    <!-- File Info -->
                    <div class="flex items-center justify-between border border-zinc-800 bg-zinc-950 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <Icon name="mdi:music-note" class="w-4 h-4 text-purple-400" />
                            <span id="aud-filename" class="text-zinc-200 font-bold truncate max-w-xs">audio.mp3</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span id="aud-duration-info" class="text-zinc-500 text-[11px]">0:00</span>
                            <span id="aud-size-info" class="text-zinc-500 text-[11px]">0 KB</span>
                        </div>
                    </div>

                    <!-- Waveform Canvas -->
                    <div class="border border-zinc-800 bg-zinc-950 p-3 relative">
                        <canvas id="aud-waveform" class="w-full" height="72"></canvas>
                        <!-- Trim handles overlay (visual) -->
                        <div id="aud-trim-overlay" class="absolute inset-3 pointer-events-none">
                            <div id="aud-trim-start-line" class="absolute top-0 bottom-0 w-0.5 bg-emerald-400" style="left:0%"></div>
                            <div id="aud-trim-end-line" class="absolute top-0 bottom-0 w-0.5 bg-red-400" style="left:100%"></div>
                            <div id="aud-trim-region" class="absolute top-0 bottom-0 bg-emerald-500/10 border-x border-emerald-700/40" style="left:0%;right:0%"></div>
                        </div>
                    </div>

                    <!-- Playback Controls -->
                    <div class="flex items-center gap-3 border border-zinc-800 bg-zinc-950 px-4 py-3">
                        <button id="aud-play-btn" class="img-action-btn">▶ Play</button>
                        <span id="aud-current-time" class="text-zinc-400 text-[11px]">0:00</span>
                        <div class="flex-1 bg-zinc-900 h-1.5 cursor-pointer relative" id="aud-scrubber">
                            <div id="aud-progress-bar" class="absolute top-0 left-0 h-full bg-purple-500" style="width:0%"></div>
                        </div>
                        <span id="aud-total-time" class="text-zinc-400 text-[11px]">0:00</span>
                        <audio id="aud-player" class="hidden"></audio>
                    </div>

                    <!-- Trim Controls -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Trim (seconds)</p>
                        <div class="flex gap-4 items-center flex-wrap">
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px]">Start:</label>
                                <input type="number" id="aud-trim-start" min="0" value="0" step="0.1" class="w-24 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-emerald-400 outline-none focus:border-zinc-500" />
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px]">End:</label>
                                <input type="number" id="aud-trim-end" min="0" value="0" step="0.1" class="w-24 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-red-400 outline-none focus:border-zinc-500" />
                            </div>
                            <button class="img-action-btn" id="aud-trim-preview">[ Preview Selection ]</button>
                        </div>
                    </div>

                    <!-- Adjustments -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Adjustments</p>
                        <div class="space-y-2.5">
                            <div class="filter-row">
                                <span class="w-28 text-zinc-500 text-[10px]">Volume / Gain</span>
                                <input type="range" id="aud-gain" min="10" max="300" value="100" class="flex-1 accent-purple-500 cursor-pointer" />
                                <span id="aud-gain-val" class="w-10 text-right text-purple-400 text-[10px]">100%</span>
                            </div>
                            <div class="filter-row">
                                <span class="w-28 text-zinc-500 text-[10px]">Fade In (s)</span>
                                <input type="range" id="aud-fade-in" min="0" max="5" value="0" step="0.1" class="flex-1 accent-purple-500 cursor-pointer" />
                                <span id="aud-fade-in-val" class="w-10 text-right text-purple-400 text-[10px]">0s</span>
                            </div>
                            <div class="filter-row">
                                <span class="w-28 text-zinc-500 text-[10px]">Fade Out (s)</span>
                                <input type="range" id="aud-fade-out" min="0" max="5" value="0" step="0.1" class="flex-1 accent-purple-500 cursor-pointer" />
                                <span id="aud-fade-out-val" class="w-10 text-right text-purple-400 text-[10px]">0s</span>
                            </div>
                        </div>
                    </div>

                    <!-- Export -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Export</p>
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="text-zinc-500 text-[10px]">Output: WAV (lossless, browser-native)</span>
                            <button id="aud-process-btn" class="btn-primary ml-auto">[ Process & Download WAV ]</button>
                        </div>
                        <div id="aud-status" class="hidden text-[11px] text-purple-400 font-mono py-1">Processing audio in browser memory...</div>
                    </div>
                </div>
            </div>

            <!-- ========== VIDEO TAB ========== -->
            <div id="tab-video" class="tab-content hidden p-5 md:p-6 space-y-5">
                <!-- Dropzone -->
                <div id="vid-dropzone" class="border-2 border-dashed border-zinc-800 bg-zinc-950 p-8 text-center cursor-pointer hover:border-zinc-600 transition-colors select-none">
                    <input type="file" id="vid-input" class="hidden" accept="video/*" />
                    <div class="w-10 h-10 border border-zinc-800 bg-zinc-900/60 flex items-center justify-center mx-auto mb-3">
                        <Icon name="mdi:video-plus-outline" class="w-5 h-5 text-sky-400" />
                    </div>
                    <p class="text-xs font-mono text-zinc-200 font-bold mb-1">Click or drag & drop video</p>
                    <p class="text-[11px] font-mono text-zinc-500">MP4, WebM, MOV, AVI, MKV</p>
                </div>

                <!-- Editor Panel -->
                <div id="vid-editor" class="hidden space-y-4 font-mono text-xs">
                    <!-- File Info -->
                    <div class="flex items-center justify-between border border-zinc-800 bg-zinc-950 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <Icon name="mdi:video" class="w-4 h-4 text-sky-400" />
                            <span id="vid-filename" class="text-zinc-200 font-bold truncate max-w-xs">video.mp4</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span id="vid-res-info" class="text-zinc-500 text-[11px]">0×0</span>
                            <span id="vid-duration-info" class="text-zinc-500 text-[11px]">0:00</span>
                        </div>
                    </div>

                    <!-- Video Player -->
                    <div class="border border-zinc-800 bg-black flex items-center justify-center relative">
                        <video id="vid-player" class="w-full max-h-[360px] object-contain" preload="metadata"></video>
                    </div>

                    <!-- Playback Controls -->
                    <div class="flex items-center gap-3 border border-zinc-800 bg-zinc-950 px-4 py-3 flex-wrap">
                        <button id="vid-play-btn" class="img-action-btn">▶ Play</button>
                        <span id="vid-current-time" class="text-zinc-400 text-[11px]">0:00</span>
                        <div class="flex-1 bg-zinc-900 h-1.5 cursor-pointer relative min-w-[80px]" id="vid-scrubber">
                            <div id="vid-progress-bar" class="absolute top-0 left-0 h-full bg-sky-500" style="width:0%"></div>
                        </div>
                        <span id="vid-total-time" class="text-zinc-400 text-[11px]">0:00</span>
                        <div class="flex items-center gap-2 ml-2">
                            <span class="text-zinc-500 text-[10px]">Speed:</span>
                            <select id="vid-speed" class="bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-zinc-100 outline-none">
                                <option value="0.5">0.5×</option>
                                <option value="1" selected>1.0×</option>
                                <option value="1.5">1.5×</option>
                                <option value="2">2.0×</option>
                            </select>
                        </div>
                    </div>

                    <!-- Trim Controls -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Trim Segment (seconds)</p>
                        <div class="flex gap-4 items-center flex-wrap">
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px]">Start:</label>
                                <input type="number" id="vid-trim-start" min="0" value="0" step="0.1" class="w-24 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-emerald-400 outline-none focus:border-zinc-500" />
                                <button class="img-action-btn text-[10px]" id="vid-set-start">[ Set Current ]</button>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px]">End:</label>
                                <input type="number" id="vid-trim-end" min="0" value="0" step="0.1" class="w-24 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-red-400 outline-none focus:border-zinc-500" />
                                <button class="img-action-btn text-[10px]" id="vid-set-end">[ Set Current ]</button>
                            </div>
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Visual Filters (Preview)</p>
                        <div class="space-y-2.5">
                            <div class="filter-row">
                                <span class="w-24 text-zinc-500 text-[10px]">Brightness</span>
                                <input type="range" id="vf-brightness" min="0" max="200" value="100" class="flex-1 accent-sky-500 cursor-pointer" />
                                <span id="vf-brightness-val" class="w-8 text-right text-sky-400 text-[10px]">100</span>
                            </div>
                            <div class="filter-row">
                                <span class="w-24 text-zinc-500 text-[10px]">Contrast</span>
                                <input type="range" id="vf-contrast" min="0" max="200" value="100" class="flex-1 accent-sky-500 cursor-pointer" />
                                <span id="vf-contrast-val" class="w-8 text-right text-sky-400 text-[10px]">100</span>
                            </div>
                            <div class="filter-row">
                                <span class="w-24 text-zinc-500 text-[10px]">Saturation</span>
                                <input type="range" id="vf-saturate" min="0" max="200" value="100" class="flex-1 accent-sky-500 cursor-pointer" />
                                <span id="vf-saturate-val" class="w-8 text-right text-sky-400 text-[10px]">100</span>
                            </div>
                            <div class="filter-row">
                                <span class="w-24 text-zinc-500 text-[10px]">Grayscale</span>
                                <input type="range" id="vf-grayscale" min="0" max="100" value="0" class="flex-1 accent-sky-500 cursor-pointer" />
                                <span id="vf-grayscale-val" class="w-8 text-right text-sky-400 text-[10px]">0</span>
                            </div>
                        </div>
                    </div>

                    <!-- Export -->
                    <div class="border border-zinc-800 bg-zinc-950/60 p-4 space-y-3">
                        <p class="text-zinc-400 text-[11px] uppercase tracking-widest font-bold">Export</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px] shrink-0">Quality/Bitrate:</label>
                                <input type="range" id="vid-bitrate" min="500" max="8000" value="2500" step="100" class="flex-1 accent-sky-500 cursor-pointer" />
                                <span id="vid-bitrate-val" class="w-16 text-right text-sky-400 text-[10px]">2500kbps</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-zinc-500 text-[10px]">Format:</label>
                                <select id="vid-export-format" class="flex-1 bg-zinc-900 border border-zinc-700 px-2 py-1 text-xs font-mono text-zinc-100 outline-none">
                                    <option value="video/webm;codecs=vp9">WebM/VP9</option>
                                    <option value="video/webm;codecs=vp8">WebM/VP8</option>
                                    <option value="video/mp4">MP4 (if supported)</option>
                                </select>
                            </div>
                        </div>
                        <div id="vid-status" class="hidden text-[11px] text-sky-400 font-mono py-1">Recording trimmed segment via MediaRecorder... This may take a while for long videos.</div>
                        <div id="vid-progress-wrap" class="hidden">
                            <div class="bg-zinc-900 h-1.5 w-full">
                                <div id="vid-rec-progress" class="h-full bg-sky-500 transition-all" style="width:0%"></div>
                            </div>
                        </div>
                        <button id="vid-process-btn" class="btn-primary w-full">[ Record Trim & Download ]</button>
                        <p class="text-[10px] text-zinc-600">Note: Browser MediaRecorder re-encodes video in real-time. Recording duration = clip length. For trim-only pass-through, a native tool like ffmpeg is faster.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Link -->
        <div class="flex justify-center mb-12">
            <a href="/tools" class="btn-primary">
                [ return to tools ]
            </a>
        </div>
    </div>
</Layout>

<style>
    .filter-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .img-action-btn {
        @apply px-3 py-1.5 bg-zinc-900 border border-zinc-700 text-zinc-300 hover:border-zinc-500 hover:text-white transition-all text-xs font-mono cursor-pointer;
    }
</style>

<!-- Load omggif for frame-by-frame animated GIF decoding -->
<script is:inline src="https://cdn.jsdelivr.net/npm/omggif@1.0.10/omggif.js"></script>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

    // =========================================================
    // TAB SWITCHING
    // =========================================================
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => b.classList.remove('active'));
            tabContents.forEach(c => c.classList.add('hidden'));
            btn.classList.add('active');
            document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
        });
    });

    // =========================================================
    // UTILITIES
    // =========================================================
    function formatBytes(bytes) {
        if (!bytes) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = Math.floor(seconds % 60);
        return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function setupDropzone(dropzoneId, inputId, handler) {
        const dz = document.getElementById(dropzoneId);
        const input = document.getElementById(inputId);
        if (!dz || !input) return;
        dz.addEventListener('click', () => input.click());
        dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-zinc-500'); });
        dz.addEventListener('dragleave', () => dz.classList.remove('border-zinc-500'));
        dz.addEventListener('drop', e => {
            e.preventDefault();
            dz.classList.remove('border-zinc-500');
            if (e.dataTransfer.files?.[0]) handler(e.dataTransfer.files[0]);
        });
        input.addEventListener('change', e => { if (e.target.files?.[0]) handler(e.target.files[0]); });
    }

    // =========================================================
    // IMAGE EDITOR (Static Images & Multi-Frame Animated GIFs)
    // =========================================================
    let imgState = {
        file: null,
        img: null,
        rotation: 0,
        flipH: false,
        flipV: false,
        aspectRatio: 1,
        isAnimated: false,
        frames: [],
        currentFrame: 0,
        animTimer: null,
        bakedText: null
    };

    const imgCanvas = document.getElementById('img-canvas');
    const imgCtx = imgCanvas.getContext('2d');

    function getImgFilters() {
        return `brightness(${document.getElementById('f-brightness').value}%) contrast(${document.getElementById('f-contrast').value}%) saturate(${document.getElementById('f-saturate').value}%) blur(${document.getElementById('f-blur').value}px) grayscale(${document.getElementById('f-grayscale').value}%) sepia(${document.getElementById('f-sepia').value}%)`;
    }

    function drawImage() {
        let source = imgState.img;
        if (imgState.isAnimated && imgState.frames && imgState.frames.length > 0) {
            source = imgState.frames[imgState.currentFrame].canvas;
        }
        if (!source) return;

        const rot = imgState.rotation;
        const swapped = rot === 90 || rot === 270;
        const w = swapped ? source.height : source.width;
        const h = swapped ? source.width : source.height;

        imgCanvas.width = w;
        imgCanvas.height = h;
        imgCtx.save();
        imgCtx.filter = getImgFilters();
        imgCtx.translate(w / 2, h / 2);
        imgCtx.rotate((rot * Math.PI) / 180);
        imgCtx.scale(imgState.flipH ? -1 : 1, imgState.flipV ? -1 : 1);
        imgCtx.drawImage(source, -source.width / 2, -source.height / 2);
        imgCtx.restore();

        // Render baked text overlay on top of frame if present
        if (imgState.bakedText) {
            imgCtx.save();
            imgCtx.font = imgState.bakedText.font;
            imgCtx.fillStyle = imgState.bakedText.color;
            imgCtx.globalAlpha = 0.85;
            imgCtx.shadowColor = 'rgba(0,0,0,0.8)';
            imgCtx.shadowBlur = 3;
            imgCtx.fillText(imgState.bakedText.text, 20, h - 20);
            imgCtx.restore();
        }
    }

    function stopGifLoop() {
        if (imgState.animTimer) {
            clearTimeout(imgState.animTimer);
            imgState.animTimer = null;
        }
    }

    function startGifLoop() {
        stopGifLoop();
        if (!imgState.isAnimated || !imgState.frames || imgState.frames.length <= 1) return;

        function step() {
            if (!imgState.isAnimated) return;
            imgState.currentFrame = (imgState.currentFrame + 1) % imgState.frames.length;
            drawImage();
            const delay = imgState.frames[imgState.currentFrame]?.delay || 100;
            imgState.animTimer = setTimeout(step, delay);
        }
        const delay = imgState.frames[0]?.delay || 100;
        imgState.animTimer = setTimeout(step, delay);
    }

    async function loadImage(file) {
        imgState.file = file;
        stopGifLoop();
        imgState.isAnimated = false;
        imgState.frames = [];
        imgState.currentFrame = 0;
        imgState.bakedText = null;

        document.getElementById('img-filename').textContent = file.name;
        document.getElementById('img-animated-badge').classList.add('hidden');

        // Check if GIF
        if (file.type === 'image/gif' || file.name.toLowerCase().endsWith('.gif')) {
            try {
                const arrayBuffer = await file.arrayBuffer();
                if (typeof GifReader !== 'undefined') {
                    const reader = new GifReader(new Uint8Array(arrayBuffer));
                    const numFrames = reader.numFrames();
                    if (numFrames > 1) {
                        const w = reader.width;
                        const h = reader.height;
                        const frames = [];

                        const compCanvas = document.createElement('canvas');
                        compCanvas.width = w;
                        compCanvas.height = h;
                        const compCtx = compCanvas.getContext('2d');

                        for (let i = 0; i < numFrames; i++) {
                            const info = reader.frameInfo(i);
                            const frameData = compCtx.createImageData(w, h);
                            reader.decodeAndBlitFrameRGBA(i, frameData.data);

                            const tempCanvas = document.createElement('canvas');
                            tempCanvas.width = w;
                            tempCanvas.height = h;
                            tempCanvas.getContext('2d').putImageData(frameData, 0, 0);

                            compCtx.drawImage(tempCanvas, 0, 0);

                            const frameCanvas = document.createElement('canvas');
                            frameCanvas.width = w;
                            frameCanvas.height = h;
                            frameCanvas.getContext('2d').drawImage(compCanvas, 0, 0);

                            frames.push({
                                canvas: frameCanvas,
                                delay: Math.max(20, (info.delay || 10) * 10)
                            });

                            if (info.disposal === 2) {
                                compCtx.clearRect(info.x, info.y, info.width, info.height);
                            }
                        }

                        imgState.isAnimated = true;
                        imgState.frames = frames;
                        imgState.currentFrame = 0;
                        imgState.img = frames[0].canvas;
                        imgState.rotation = 0;
                        imgState.flipH = false;
                        imgState.flipV = false;
                        imgState.aspectRatio = w / h;

                        document.getElementById('img-resize-w').value = w;
                        document.getElementById('img-resize-h').value = h;
                        document.getElementById('img-dim-info').textContent = `${w}×${h}`;

                        const formatSelect = document.getElementById('img-export-format');
                        formatSelect.innerHTML = `
                            <option value="image/gif" selected>GIF (Animated - Preserves Frames)</option>
                            <option value="image/webp">WebP (Static Snapshot)</option>
                            <option value="image/png">PNG (Static Snapshot)</option>
                            <option value="image/jpeg">JPEG (Static Snapshot)</option>
                        `;

                        const badge = document.getElementById('img-animated-badge');
                        badge.textContent = `● Animated GIF (${numFrames} frames)`;
                        badge.classList.remove('hidden');

                        drawImage();
                        startGifLoop();

                        document.getElementById('img-dropzone').classList.add('hidden');
                        document.getElementById('img-editor').classList.remove('hidden');
                        return;
                    }
                }
            } catch (err) {
                console.warn('GIF decode fallback to standard image loader:', err);
            }
        }

        // Standard Static Image
        const formatSelect = document.getElementById('img-export-format');
        formatSelect.innerHTML = `
            <option value="image/webp" selected>WebP (Recommended)</option>
            <option value="image/jpeg">JPEG</option>
            <option value="image/png">PNG (Lossless)</option>
        `;

        const reader = new FileReader();
        reader.onload = e => {
            const img = new Image();
            img.onload = () => {
                imgState.img = img;
                imgState.rotation = 0;
                imgState.flipH = false;
                imgState.flipV = false;
                imgState.aspectRatio = img.width / img.height;
                document.getElementById('img-resize-w').value = img.width;
                document.getElementById('img-resize-h').value = img.height;
                document.getElementById('img-dim-info').textContent = `${img.width}×${img.height}`;
                drawImage();
                document.getElementById('img-dropzone').classList.add('hidden');
                document.getElementById('img-editor').classList.remove('hidden');
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    setupDropzone('img-dropzone', 'img-input', loadImage);

    // Filter sliders live update
    ['brightness', 'contrast', 'saturate', 'blur', 'grayscale', 'sepia'].forEach(id => {
        const slider = document.getElementById('f-' + id);
        const valEl = document.getElementById('f-' + id + '-val');
        if (!slider) return;
        slider.addEventListener('input', () => {
            valEl.textContent = slider.value;
            drawImage();
        });
    });

    // Resize lock ratio
    document.getElementById('img-resize-w')?.addEventListener('input', e => {
        if (document.getElementById('img-lock-ratio')?.checked && imgState.img) {
            document.getElementById('img-resize-h').value = Math.round(parseInt(e.target.value) / imgState.aspectRatio) || '';
        }
    });
    document.getElementById('img-resize-h')?.addEventListener('input', e => {
        if (document.getElementById('img-lock-ratio')?.checked && imgState.img) {
            document.getElementById('img-resize-w').value = Math.round(parseInt(e.target.value) * imgState.aspectRatio) || '';
        }
    });

    // Quality slider
    document.getElementById('img-quality')?.addEventListener('input', e => {
        document.getElementById('img-quality-val').textContent = e.target.value + '%';
    });

    // ---- Live text overlay ----
    const textOverlay = document.getElementById('img-text-overlay');

    function updateTextOverlay() {
        const text = document.getElementById('img-text').value;
        const color = document.getElementById('img-text-color').value;
        const size = parseInt(document.getElementById('img-text-size').value);
        document.getElementById('img-text-size-val').textContent = size + 'px';

        if (!text || !imgState.img) {
            textOverlay.classList.add('hidden');
            return;
        }
        textOverlay.classList.remove('hidden');
        textOverlay.textContent = text;
        textOverlay.style.color = color;
        textOverlay.style.fontSize = size + 'px';
    }

    document.getElementById('img-text')?.addEventListener('input', updateTextOverlay);
    document.getElementById('img-text-color')?.addEventListener('input', updateTextOverlay);
    document.getElementById('img-text-size')?.addEventListener('input', updateTextOverlay);

    // Action buttons
    document.querySelectorAll('.img-action-btn[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
            const action = btn.dataset.action;
            if (!imgState.img && action !== 'reset-all') return;
            switch (action) {
                case 'rotate-cw': imgState.rotation = (imgState.rotation + 90) % 360; drawImage(); break;
                case 'rotate-ccw': imgState.rotation = (imgState.rotation - 90 + 360) % 360; drawImage(); break;
                case 'flip-h': imgState.flipH = !imgState.flipH; drawImage(); break;
                case 'flip-v': imgState.flipV = !imgState.flipV; drawImage(); break;
                case 'resize': {
                    const w = parseInt(document.getElementById('img-resize-w').value);
                    const h = parseInt(document.getElementById('img-resize-h').value);
                    if (!w || !h) return;
                    if (imgState.isAnimated) {
                        imgState.aspectRatio = w / h;
                        drawImage();
                    } else {
                        const tempCanvas = document.createElement('canvas');
                        tempCanvas.width = w; tempCanvas.height = h;
                        tempCanvas.getContext('2d').drawImage(imgCanvas, 0, 0, w, h);
                        const newImg = new Image();
                        newImg.onload = () => { imgState.img = newImg; imgState.aspectRatio = w / h; drawImage(); };
                        newImg.src = tempCanvas.toDataURL();
                    }
                    break;
                }
                case 'add-text': {
                    const text = document.getElementById('img-text').value;
                    if (!text) return;
                    const size = parseInt(document.getElementById('img-text-size').value);
                    const color = document.getElementById('img-text-color').value;

                    imgState.bakedText = {
                        text,
                        size,
                        color,
                        font: `bold ${size}px JetBrains Mono, monospace`
                    };

                    if (!imgState.isAnimated) {
                        drawImage();
                        const baked = new Image();
                        baked.onload = () => { imgState.img = baked; };
                        baked.src = imgCanvas.toDataURL();
                    } else {
                        drawImage();
                    }

                    document.getElementById('img-text').value = '';
                    textOverlay.classList.add('hidden');
                    break;
                }
                case 'clear-text': {
                    document.getElementById('img-text').value = '';
                    imgState.bakedText = null;
                    textOverlay.classList.add('hidden');
                    drawImage();
                    break;
                }
                case 'reset-filters': {
                    ['brightness', 'contrast', 'saturate'].forEach(id => {
                        const el = document.getElementById('f-' + id);
                        if (el) { el.value = 100; document.getElementById('f-' + id + '-val').textContent = '100'; }
                    });
                    ['blur', 'grayscale', 'sepia'].forEach(id => {
                        const el = document.getElementById('f-' + id);
                        if (el) { el.value = 0; document.getElementById('f-' + id + '-val').textContent = '0'; }
                    });
                    drawImage();
                    break;
                }
                case 'reset-all': {
                    stopGifLoop();
                    imgState = { file: null, img: null, rotation: 0, flipH: false, flipV: false, aspectRatio: 1, isAnimated: false, frames: [], currentFrame: 0, animTimer: null, bakedText: null };
                    imgCanvas.width = 0; imgCanvas.height = 0;
                    document.getElementById('img-dropzone').classList.remove('hidden');
                    document.getElementById('img-editor').classList.add('hidden');
                    document.getElementById('img-input').value = '';
                    document.getElementById('img-text').value = '';
                    textOverlay.classList.add('hidden');
                    break;
                }
            }
        });
    });

    // Download image (Static or Animated GIF)
    document.getElementById('img-download')?.addEventListener('click', async () => {
        if (!imgState.img) return;
        const format = document.getElementById('img-export-format').value;
        const base = imgState.file ? imgState.file.name.replace(/\.[^/.]+$/, '') : 'edited';
        const statusEl = document.getElementById('img-status');
        const downloadBtn = document.getElementById('img-download');

        if (imgState.isAnimated && format === 'image/gif') {
            statusEl.classList.remove('hidden');
            statusEl.textContent = `[ Encoding animated GIF (${imgState.frames.length} frames)... ]`;
            downloadBtn.disabled = true;

            try {
                const { GIFEncoder, quantize, applyPalette } = await import('https://cdn.jsdelivr.net/npm/gifenc@1.0.3/dist/gifenc.esm.js');
                const gif = GIFEncoder();

                const rot = imgState.rotation;
                const swapped = rot === 90 || rot === 270;
                const srcSample = imgState.frames[0].canvas;
                const origW = swapped ? srcSample.height : srcSample.width;
                const origH = swapped ? srcSample.width : srcSample.height;
                const tw = parseInt(document.getElementById('img-resize-w').value) || origW;
                const th = parseInt(document.getElementById('img-resize-h').value) || origH;

                const offCanvas = document.createElement('canvas');
                offCanvas.width = tw;
                offCanvas.height = th;
                const offCtx = offCanvas.getContext('2d');

                for (let i = 0; i < imgState.frames.length; i++) {
                    const frame = imgState.frames[i];
                    statusEl.textContent = `[ Processing frame ${i + 1} of ${imgState.frames.length}... ]`;

                    offCtx.clearRect(0, 0, tw, th);
                    offCtx.save();
                    offCtx.filter = getImgFilters();
                    offCtx.translate(tw / 2, th / 2);
                    offCtx.rotate((rot * Math.PI) / 180);
                    offCtx.scale(imgState.flipH ? -1 : 1, imgState.flipV ? -1 : 1);
                    offCtx.drawImage(frame.canvas, -srcSample.width / 2, -srcSample.height / 2, srcSample.width, srcSample.height);
                    offCtx.restore();

                    if (imgState.bakedText) {
                        offCtx.save();
                        offCtx.font = imgState.bakedText.font;
                        offCtx.fillStyle = imgState.bakedText.color;
                        offCtx.globalAlpha = 0.85;
                        offCtx.shadowColor = 'rgba(0,0,0,0.8)';
                        offCtx.shadowBlur = 3;
                        offCtx.fillText(imgState.bakedText.text, 20, th - 20);
                        offCtx.restore();
                    }

                    const imgData = offCtx.getImageData(0, 0, tw, th);
                    const palette = quantize(imgData.data, 256);
                    const index = applyPalette(imgData.data, palette);
                    gif.writeFrame(index, tw, th, {
                        palette,
                        delay: frame.delay || 100,
                        repeat: 0
                    });
                }

                gif.finish();
                const blob = new Blob([gif.bytes()], { type: 'image/gif' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${base}_edited.gif`;
                a.click();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
                statusEl.textContent = '✓ Animated GIF exported!';
                setTimeout(() => statusEl.classList.add('hidden'), 2500);
            } catch (err) {
                console.error('GIF export error:', err);
                statusEl.textContent = `❌ Error: ${err.message}`;
            } finally {
                downloadBtn.disabled = false;
            }
        } else {
            const quality = parseInt(document.getElementById('img-quality').value) / 100;
            const ext = format === 'image/png' ? 'png' : format === 'image/jpeg' ? 'jpg' : format === 'image/gif' ? 'gif' : 'webp';
            const url = imgCanvas.toDataURL(format, quality);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${base}_edited.${ext}`;
            a.click();
        }
    });

    // =========================================================
    // AUDIO EDITOR
    // =========================================================
    let audState = { file: null, buffer: null, duration: 0, objectUrl: null };
    const audPlayer = document.getElementById('aud-player');
    const audWaveform = document.getElementById('aud-waveform');
    const audWaveCtx = audWaveform.getContext('2d');

    setupDropzone('aud-dropzone', 'aud-input', loadAudio);

    function drawWaveform(buffer) {
        const data = buffer.getChannelData(0);
        const W = audWaveform.offsetWidth || 600;
        const H = 72;
        audWaveform.width = W;
        audWaveform.height = H;
        audWaveCtx.clearRect(0, 0, W, H);
        const step = Math.ceil(data.length / W);
        audWaveCtx.strokeStyle = '#a855f7';
        audWaveCtx.lineWidth = 1;
        for (let i = 0; i < W; i++) {
            let min = 1, max = -1;
            for (let j = 0; j < step; j++) {
                const d = data[(i * step) + j] || 0;
                if (d < min) min = d;
                if (d > max) max = d;
            }
            audWaveCtx.beginPath();
            audWaveCtx.moveTo(i, (1 + min) / 2 * H);
            audWaveCtx.lineTo(i, (1 + max) / 2 * H);
            audWaveCtx.stroke();
        }
    }

    function updateAudTrimOverlay() {
        const dur = audState.duration;
        if (!dur) return;
        const start = Math.min(parseFloat(document.getElementById('aud-trim-start').value) || 0, dur);
        const end = Math.min(parseFloat(document.getElementById('aud-trim-end').value) || dur, dur);
        const startPct = (start / dur) * 100;
        const endPct = (end / dur) * 100;
        document.getElementById('aud-trim-start-line').style.left = startPct + '%';
        document.getElementById('aud-trim-end-line').style.left = endPct + '%';
        document.getElementById('aud-trim-region').style.left = startPct + '%';
        document.getElementById('aud-trim-region').style.right = (100 - endPct) + '%';
    }

    ['aud-trim-start', 'aud-trim-end'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', updateAudTrimOverlay);
    });

    async function loadAudio(file) {
        audState.file = file;
        if (audState.objectUrl) URL.revokeObjectURL(audState.objectUrl);
        audState.objectUrl = URL.createObjectURL(file);
        audPlayer.src = audState.objectUrl;

        document.getElementById('aud-filename').textContent = file.name;
        document.getElementById('aud-size-info').textContent = formatBytes(file.size);

        const arrayBuffer = await file.arrayBuffer();
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        audState.buffer = await audioCtx.decodeAudioData(arrayBuffer);
        audState.duration = audState.buffer.duration;
        audioCtx.close();

        document.getElementById('aud-duration-info').textContent = formatTime(audState.duration);
        document.getElementById('aud-total-time').textContent = formatTime(audState.duration);
        document.getElementById('aud-trim-end').value = audState.duration.toFixed(1);

        drawWaveform(audState.buffer);
        updateAudTrimOverlay();

        document.getElementById('aud-dropzone').classList.add('hidden');
        document.getElementById('aud-editor').classList.remove('hidden');
    }

    // Playback controls
    document.getElementById('aud-play-btn')?.addEventListener('click', () => {
        if (audPlayer.paused) { audPlayer.play(); document.getElementById('aud-play-btn').textContent = '⏸ Pause'; }
        else { audPlayer.pause(); document.getElementById('aud-play-btn').textContent = '▶ Play'; }
    });

    audPlayer.addEventListener('timeupdate', () => {
        document.getElementById('aud-current-time').textContent = formatTime(audPlayer.currentTime);
        const pct = audState.duration ? (audPlayer.currentTime / audState.duration) * 100 : 0;
        document.getElementById('aud-progress-bar').style.width = pct + '%';
    });
    audPlayer.addEventListener('ended', () => {
        document.getElementById('aud-play-btn').textContent = '▶ Play';
    });

    document.getElementById('aud-scrubber')?.addEventListener('click', e => {
        const rect = e.currentTarget.getBoundingClientRect();
        const pct = (e.clientX - rect.left) / rect.width;
        audPlayer.currentTime = pct * audState.duration;
    });

    // Preview selection
    document.getElementById('aud-trim-preview')?.addEventListener('click', () => {
        const start = parseFloat(document.getElementById('aud-trim-start').value) || 0;
        audPlayer.currentTime = start;
        audPlayer.play();
        document.getElementById('aud-play-btn').textContent = '⏸ Pause';
    });

    // Gain/fade sliders
    document.getElementById('aud-gain')?.addEventListener('input', e => {
        document.getElementById('aud-gain-val').textContent = e.target.value + '%';
    });
    document.getElementById('aud-fade-in')?.addEventListener('input', e => {
        document.getElementById('aud-fade-in-val').textContent = e.target.value + 's';
    });
    document.getElementById('aud-fade-out')?.addEventListener('input', e => {
        document.getElementById('aud-fade-out-val').textContent = e.target.value + 's';
    });

    // Process & export audio (WAV via OfflineAudioContext)
    document.getElementById('aud-process-btn')?.addEventListener('click', async () => {
        if (!audState.buffer) return;
        const statusEl = document.getElementById('aud-status');
        statusEl.classList.remove('hidden');

        const dur = audState.duration;
        const startSec = Math.max(0, parseFloat(document.getElementById('aud-trim-start').value) || 0);
        const endSec = Math.min(dur, parseFloat(document.getElementById('aud-trim-end').value) || dur);
        const clipDur = Math.max(0.01, endSec - startSec);
        const gain = (parseInt(document.getElementById('aud-gain').value) || 100) / 100;
        const fadeIn = parseFloat(document.getElementById('aud-fade-in').value) || 0;
        const fadeOut = parseFloat(document.getElementById('aud-fade-out').value) || 0;
        const sampleRate = audState.buffer.sampleRate;
        const numCh = audState.buffer.numberOfChannels;

        const offline = new OfflineAudioContext(numCh, Math.ceil(clipDur * sampleRate), sampleRate);
        const source = offline.createBufferSource();
        source.buffer = audState.buffer;
        const gainNode = offline.createGain();
        gainNode.gain.setValueAtTime(gain, 0);
        if (fadeIn > 0) {
            gainNode.gain.setValueAtTime(0, 0);
            gainNode.gain.linearRampToValueAtTime(gain, fadeIn);
        }
        if (fadeOut > 0) {
            gainNode.gain.setValueAtTime(gain, Math.max(0, clipDur - fadeOut));
            gainNode.gain.linearRampToValueAtTime(0, clipDur);
        }
        source.connect(gainNode);
        gainNode.connect(offline.destination);
        source.start(0, startSec, clipDur);

        const rendered = await offline.startRendering();
        const wavBlob = audioBufferToWav(rendered);
        const url = URL.createObjectURL(wavBlob);
        const base = audState.file.name.replace(/\.[^/.]+$/, '');
        const a = document.createElement('a');
        a.href = url; a.download = `${base}_edited.wav`; a.click();
        statusEl.classList.add('hidden');
    });

    // Simple WAV encoder
    function audioBufferToWav(buffer) {
        const numChannels = buffer.numberOfChannels;
        const sampleRate = buffer.sampleRate;
        const format = 1; // PCM
        const bitDepth = 16;
        const bytesPerSample = bitDepth / 8;
        const blockAlign = numChannels * bytesPerSample;
        const numFrames = buffer.length;
        const dataLength = numFrames * blockAlign;
        const totalLength = 44 + dataLength;
        const arrayBuffer = new ArrayBuffer(totalLength);
        const view = new DataView(arrayBuffer);

        function writeStr(offset, str) {
            for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
        }
        writeStr(0, 'RIFF'); view.setUint32(4, 36 + dataLength, true);
        writeStr(8, 'WAVE'); writeStr(12, 'fmt '); view.setUint32(16, 16, true);
        view.setUint16(20, format, true); view.setUint16(22, numChannels, true);
        view.setUint32(24, sampleRate, true); view.setUint32(28, sampleRate * blockAlign, true);
        view.setUint16(32, blockAlign, true); view.setUint16(34, bitDepth, true);
        writeStr(36, 'data'); view.setUint32(40, dataLength, true);

        let offset = 44;
        for (let i = 0; i < numFrames; i++) {
            for (let ch = 0; ch < numChannels; ch++) {
                const sample = Math.max(-1, Math.min(1, buffer.getChannelData(ch)[i]));
                view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);
                offset += 2;
            }
        }
        return new Blob([arrayBuffer], { type: 'audio/wav' });
    }

    // =========================================================
    // VIDEO EDITOR
    // =========================================================
    let vidState = { file: null, duration: 0, objectUrl: null, recorder: null };
    const vidPlayer = document.getElementById('vid-player');

    setupDropzone('vid-dropzone', 'vid-input', loadVideo);

    function loadVideo(file) {
        vidState.file = file;
        if (vidState.objectUrl) URL.revokeObjectURL(vidState.objectUrl);
        vidState.objectUrl = URL.createObjectURL(file);
        vidPlayer.src = vidState.objectUrl;
        document.getElementById('vid-filename').textContent = file.name;

        vidPlayer.onloadedmetadata = () => {
            vidState.duration = vidPlayer.duration;
            document.getElementById('vid-duration-info').textContent = formatTime(vidPlayer.duration);
            document.getElementById('vid-total-time').textContent = formatTime(vidPlayer.duration);
            document.getElementById('vid-res-info').textContent = `${vidPlayer.videoWidth}×${vidPlayer.videoHeight}`;
            document.getElementById('vid-trim-start').value = 0;
            document.getElementById('vid-trim-end').value = vidPlayer.duration.toFixed(1);
        };

        document.getElementById('vid-dropzone').classList.add('hidden');
        document.getElementById('vid-editor').classList.remove('hidden');
    }

    document.getElementById('vid-play-btn')?.addEventListener('click', () => {
        if (vidPlayer.paused) { vidPlayer.play(); document.getElementById('vid-play-btn').textContent = '⏸ Pause'; }
        else { vidPlayer.pause(); document.getElementById('vid-play-btn').textContent = '▶ Play'; }
    });

    vidPlayer.addEventListener('timeupdate', () => {
        document.getElementById('vid-current-time').textContent = formatTime(vidPlayer.currentTime);
        const pct = vidState.duration ? (vidPlayer.currentTime / vidState.duration) * 100 : 0;
        document.getElementById('vid-progress-bar').style.width = pct + '%';
    });
    vidPlayer.addEventListener('ended', () => { document.getElementById('vid-play-btn').textContent = '▶ Play'; });

    document.getElementById('vid-scrubber')?.addEventListener('click', e => {
        const rect = e.currentTarget.getBoundingClientRect();
        const pct = (e.clientX - rect.left) / rect.width;
        vidPlayer.currentTime = pct * vidState.duration;
    });

    document.getElementById('vid-speed')?.addEventListener('change', e => {
        vidPlayer.playbackRate = parseFloat(e.target.value);
    });

    document.getElementById('vid-set-start')?.addEventListener('click', () => {
        document.getElementById('vid-trim-start').value = vidPlayer.currentTime.toFixed(1);
    });
    document.getElementById('vid-set-end')?.addEventListener('click', () => {
        document.getElementById('vid-trim-end').value = vidPlayer.currentTime.toFixed(1);
    });

    document.getElementById('vid-bitrate')?.addEventListener('input', e => {
        document.getElementById('vid-bitrate-val').textContent = e.target.value + 'kbps';
    });

    // Video filters (CSS filter on player)
    ['vf-brightness', 'vf-contrast', 'vf-saturate', 'vf-grayscale'].forEach(id => {
        const slider = document.getElementById(id);
        const valEl = document.getElementById(id + '-val');
        if (!slider) return;
        slider.addEventListener('input', () => {
            valEl.textContent = slider.value;
            applyVidFilter();
        });
    });

    function applyVidFilter() {
        const b = document.getElementById('vf-brightness').value;
        const c = document.getElementById('vf-contrast').value;
        const s = document.getElementById('vf-saturate').value;
        const g = document.getElementById('vf-grayscale').value;
        vidPlayer.style.filter = `brightness(${b}%) contrast(${c}%) saturate(${s}%) grayscale(${g}%)`;
    }

    // Record / export via MediaRecorder
    document.getElementById('vid-process-btn')?.addEventListener('click', () => {
        if (!vidState.file) return;
        const start = parseFloat(document.getElementById('vid-trim-start').value) || 0;
        const end = parseFloat(document.getElementById('vid-trim-end').value) || vidState.duration;
        const clipDur = Math.max(0.5, end - start);
        const bitrate = parseInt(document.getElementById('vid-bitrate').value) * 1000;
        const mimeTypePref = document.getElementById('vid-export-format').value;
        const statusEl = document.getElementById('vid-status');
        const progressWrap = document.getElementById('vid-progress-wrap');
        const recBar = document.getElementById('vid-rec-progress');
        const btn = document.getElementById('vid-process-btn');

        const mimeType = MediaRecorder.isTypeSupported(mimeTypePref) ? mimeTypePref
            : MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9'
            : 'video/webm';

        statusEl.classList.remove('hidden');
        progressWrap.classList.remove('hidden');
        btn.disabled = true;
        btn.textContent = '[ Recording... ]';

        vidPlayer.currentTime = start;
        vidPlayer.muted = false;
        const stream = vidPlayer.captureStream ? vidPlayer.captureStream() : vidPlayer.mozCaptureStream ? vidPlayer.mozCaptureStream() : null;
        if (!stream) {
            statusEl.textContent = '❌ captureStream() not supported in this browser.';
            btn.disabled = false; btn.textContent = '[ Record Trim & Download ]';
            return;
        }

        const recorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: bitrate });
        vidState.recorder = recorder;
        const chunks = [];

        recorder.ondataavailable = e => { if (e.data?.size > 0) chunks.push(e.data); };
        recorder.onstop = () => {
            const blob = new Blob(chunks, { type: mimeType });
            const ext = mimeType.includes('mp4') ? 'mp4' : 'webm';
            const base = vidState.file.name.replace(/\.[^/.]+$/, '');
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = `${base}_trimmed.${ext}`; a.click();
            statusEl.classList.add('hidden');
            progressWrap.classList.add('hidden');
            btn.disabled = false;
            btn.textContent = '[ Record Trim & Download ]';
        };

        vidPlayer.play();
        recorder.start(100);

        const startTime = performance.now();
        const interval = setInterval(() => {
            const elapsed = (performance.now() - startTime) / 1000;
            const pct = Math.min((elapsed / clipDur) * 100, 100);
            recBar.style.width = pct + '%';
            if (elapsed >= clipDur) {
                clearInterval(interval);
                vidPlayer.pause();
                recorder.stop();
            }
        }, 200);
    });

});
</script>
