---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Universal Media Downloader (WIP) - Radja Genta">
    <div class="page-wrapper animate-fade-in-up">
        
        <!-- Header -->
        <section class="py-6 md:py-8 flex flex-col items-center text-center">
            <div class="hero-badge text-amber-400 border-amber-900/60">
                [ tool ] work in progress
            </div>
            
            <h1 class="heading-display mb-2 text-2xl md:text-4xl">
                Universal Media Downloader
            </h1>
            
            <p class="text-lead mb-6 text-xs md:text-sm max-w-lg">
                Download videos and audio from TikTok, YouTube, Instagram, and X/Twitter. (Currently under active development).
            </p>
        </section>

        <!-- Downloader Container Box -->
        <div class="glass-card mb-8 w-full max-w-2xl mx-auto p-6 md:p-8">
            
            <!-- Supported Platforms Pill Row -->
            <div class="flex flex-wrap gap-2 justify-center mb-6 text-[11px] font-mono select-none opacity-75">
                <span class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center gap-1">
                    <Icon name="mdi:video-outline" class="w-3.5 h-3.5 text-zinc-400" /> TikTok (No WM)
                </span>
                <span class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center gap-1">
                    <Icon name="mdi:youtube" class="w-3.5 h-3.5 text-red-500/70" /> YouTube
                </span>
                <span class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center gap-1">
                    <Icon name="mdi:instagram" class="w-3.5 h-3.5 text-pink-500/70" /> Instagram
                </span>
                <span class="px-2.5 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400 flex items-center gap-1">
                    <Icon name="mdi:twitter" class="w-3.5 h-3.5 text-sky-400/70" /> Twitter / X
                </span>
            </div>

            <!-- WIP Alert Banner -->
            <div class="p-4 bg-amber-950/30 border border-amber-900/50 mb-6 text-center font-mono text-xs text-amber-400">
                ⚠️ <strong>WORK IN PROGRESS:</strong> Media downloader backend integration is currently under active development. Direct downloading is disabled for now.
            </div>

            <!-- Disabled Form UI -->
            <form onsubmit="return false;" class="space-y-4 opacity-60">
                <div class="relative w-full">
                    <input 
                        type="url" 
                        class="w-full bg-zinc-950 border border-zinc-800 px-4 py-3 text-xs font-mono text-zinc-400 placeholder-zinc-700 cursor-not-allowed" 
                        placeholder="Downloader is currently Work in Progress..." 
                        disabled 
                        aria-label="Media URL input"
                    />
                    <button 
                        type="button" 
                        disabled 
                        class="absolute right-2 top-2 px-3 py-1 text-[11px] font-mono bg-zinc-900 border border-zinc-800 text-zinc-600 cursor-not-allowed"
                    >
                        Paste
                    </button>
                </div>

                <!-- Mode Options -->
                <div class="flex items-center justify-between text-xs font-mono pt-1 text-zinc-500">
                    <div class="flex items-center gap-4">
                        <label class="flex items-center gap-1.5 cursor-not-allowed">
                            <input type="radio" checked disabled class="cursor-not-allowed" />
                            <span>Video (HD)</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-not-allowed">
                            <input type="radio" disabled class="cursor-not-allowed" />
                            <span>Audio Only (MP3)</span>
                        </label>
                    </div>
                </div>

                <!-- Disabled Submit Button -->
                <button 
                    type="button" 
                    disabled 
                    class="btn-primary w-full text-center block mt-4 opacity-50 cursor-not-allowed text-zinc-500 border-zinc-800 hover:bg-zinc-900"
                >
                    [ Fetch & Download Media (Work in Progress) ]
                </button>
            </form>

        </div>

        <!-- Back Link -->
        <div class="flex justify-center mb-12">
            <a href="/tools" class="btn-primary">
                [ return to tools ]
            </a>
        </div>

    </div>
</Layout>
