---
import fs from 'node:fs';
import path from 'node:path';
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

const CACHE_PATH = path.resolve('src/data/github-profile-cache.json');
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;

let profileStats = null;

try {
  const headers: Record<string, string> = {
    'Accept': 'application/vnd.github.v3+json',
    'User-Agent': 'Astro-Portfolio-Builder'
  };
  if (GITHUB_TOKEN) {
    headers['Authorization'] = `token ${GITHUB_TOKEN.trim()}`;
  }

  const userRes = await fetch('https://api.github.com/users/RadjaShiqnals', { headers });
  if (userRes.ok) {
    const userData = await userRes.json();
    const reposRes = await fetch('https://api.github.com/users/RadjaShiqnals/repos?per_page=100', { headers });
    let totalStars = 0;
    let totalForks = 0;
    let languagesMap: Record<string, number> = {};

    if (reposRes.ok) {
      const reposData = await reposRes.json();
      if (Array.isArray(reposData)) {
        reposData.forEach((r: any) => {
          totalStars += r.stargazers_count || 0;
          totalForks += r.forks_count || 0;
          if (r.language) {
            languagesMap[r.language] = (languagesMap[r.language] || 0) + 1;
          }
        });
      }
    }

    const languages = Object.entries(languagesMap)
      .map(([name, count]) => ({ name, count }))
      .sort((a, b) => b.count - a.count);

    profileStats = {
      username: userData.login,
      avatar_url: userData.avatar_url,
      name: userData.name || "Radja Genta Saputra",
      bio: userData.bio || "Full-Stack Web Developer & Tech Lead at SIDIGS.",
      location: userData.location || "Probolinggo / Malang, East Java, Indonesia",
      public_repos: userData.public_repos,
      followers: userData.followers,
      following: userData.following,
      total_stars: totalStars,
      total_forks: totalForks,
      languages,
      last_updated: new Date().toISOString()
    };

    fs.writeFileSync(CACHE_PATH, JSON.stringify(profileStats, null, 2), 'utf-8');
  }
} catch (err) {
  console.error('[GitHub Profile Sync] Error fetching profile:', err);
}

if (!profileStats && fs.existsSync(CACHE_PATH)) {
  try {
    profileStats = JSON.parse(fs.readFileSync(CACHE_PATH, 'utf-8'));
  } catch (err) {
    console.error('[GitHub Profile Sync] Error reading cache:', err);
  }
}
---

<Layout title="Radja Genta Saputra - Portfolio">
	<Welcome profileStats={profileStats} />
</Layout>